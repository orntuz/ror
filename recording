                $flagged++
            }
        }

        if (-not $flagged) {
            'SUCCESS: No configured process-name/path indicators in this snapshot.'
        }

        if ($noPath) {
            "INFO: Image paths unavailable for $noPath processes; name-only coverage for those processes."
        }
    } catch {
        "UNKNOWN: Process scan failed: $($_.Exception.Message)"
    }
}

