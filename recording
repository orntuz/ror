            if ([RoR.ClarityNal]::IsNalDeviceOpenable()) {
                $alerts += 'FAILURE: Intel NAL device (\\.\Nal) is active/openable.'
            }
        } catch {
            $alerts += "WARNING: Could not query Intel NAL device: $($_.Exception.Message)"
        }
    } else {
        $alerts += 'WARNING: Intel NAL device check unavailable.'
    }

    try {
        $nalService = Get-CimInstance -ClassName Win32_SystemDriver -Filter "Name='Nal'" -ErrorAction SilentlyContinue | Select-Object -First 1
        if ($nalService) {
            $path = Resolve-KernelDriverImagePath -ServiceName 'Nal' -PathName ([string]$nalService.PathName)
            if ($nalService.State -eq 'Running') {
                $alerts += "WARNING: Intel NAL driver service is installed and running -> $path"
            } else {
                $alerts += "WARNING: Intel NAL driver service exists but is not running -> $path"
            }
        }
    } catch {}

    if ($alerts.Count -eq 0) {
        $alerts += 'SUCCESS: Intel NAL device/service not detected.'
    }

    return @($alerts | Select-Object -Unique)
}

function Test-ClarityDefenderMasquerade {
    $alerts = @()

    $msMpEngPattern = Join-Path $env:ProgramData 'Microsoft\Windows Defender\Platform\*\MsMpEng.exe'
    $tiWorkerPattern = Join-Path $env:SystemRoot '*\TiWorker.exe'

    foreach ($spec in @(
        @{ Name = 'svchost';  Paths = @((Join-Path $env:SystemRoot 'System32\svchost.exe'), (Join-Path $env:SystemRoot 'SysWOW64\svchost.exe')); Pattern = $null },
        @{ Name = 'MsMpEng';  Paths = @(); Pattern = $msMpEngPattern },
        @{ Name = 'TiWorker'; Paths = @(); Pattern = $tiWorkerPattern }
    )) {
        try {
            Get-Process -Name $spec.Name -ErrorAction SilentlyContinue | ForEach-Object {
                try {
                    $path = [string]$_.Path
                    if ([string]::IsNullOrWhiteSpace($path)) { return }

                    $valid = $false
                    if ($spec.Paths.Count -gt 0) {
                        $valid = Test-ExactCanonicalWindowsPath -CandidatePath $path -AllowedPaths $spec.Paths
                    } elseif ($spec.Pattern) {
                        $candidate = [Environment]::ExpandEnvironmentVariables($path).Trim().Trim('"').Replace('/', '\\')
                        $valid = $candidate -like $spec.Pattern
                    }

                    if (-not $valid) {
                        $alerts += "FAILURE: $($spec.Name).exe from suspicious path: '$path' (PID $($_.Id))"
                    }
                } catch {}
            }
        } catch {}
    }

    if ($alerts.Count -eq 0) {
        $alerts += 'SUCCESS: Clarity-targeted Defender/Windows process masquerade check passed.'
    }

    return @($alerts | Select-Object -Unique)
}

function Get-ClarityDetectionAlerts {
    param(
        [switch]$FullScan
    )

    $alerts = @()
    $alerts += @(Test-ClarityConfigDefender -FullScan:$FullScan)
    $alerts += @(Test-ClarityDefenderMasquerade)
    $alerts += @(Test-ClarityNalDriver)

    $defenderProc = Get-Process -Name 'MsMpEng' -ErrorAction SilentlyContinue | Select-Object -First 1
    if (-not $defenderProc) {
        $alerts += 'FAILURE: MsMpEng.exe is not running; Defender may have been killed or replaced.'
    } else {
        try {
            $path = [string]$defenderProc.Path
            $expectedPattern = Join-Path $env:ProgramData 'Microsoft\Windows Defender\Platform\*\MsMpEng.exe'
            if ($path -and ($path.Replace('/', '\\') -notlike $expectedPattern)) {
                $alerts += "FAILURE: MsMpEng.exe is running from an unexpected path: '$path'"
            }
        } catch {}
    }

    try {
        $rtpKey = 'HKLM:\SOFTWARE\Microsoft\Windows Defender\Real-Time Protection'
        $value = Get-ItemPropertyValue -Path $rtpKey -Name 'DisableRealtimeMonitoring' -ErrorAction Stop
        if ([int]$value -ne 0) {
            $alerts += 'FAILURE: Registry shows Defender real-time protection is disabled (DisableRealtimeMonitoring != 0).'
        }
    } catch {}

    $successOnly = ($alerts.Count -gt 0 -and @($alerts | Where-Object { $_ -notlike 'SUCCESS*' -and $_ -notlike 'INFO*' -and $_ -notlike 'WARNING*' }).Count -eq 0)
    if ($successOnly) {
        $alerts += 'SUCCESS: Clarity-specific Defender integrity checks completed.'
    }

    return @($alerts | Select-Object -Unique)
}

function Get-DefenderStatusAlerts {
    $alerts = @()

    if (-not $script:DefenderAvailable) {
        $alerts += 'WARNING: Windows Defender PowerShell module/cmdlets unavailable'
        return $alerts
    }

    try {
        $def = Defender\Get-MpComputerStatus -ErrorAction Stop
        if (-not $def.RealTimeProtectionEnabled) {
            $alerts += 'FAILURE: Real-time protection disabled'
        }
        if (-not $def.IsTamperProtected) {
            $alerts += 'WARNING: Tamper protection disabled'
        }
    } catch {
        $alerts += 'WARNING: Defender status unavailable'
    }

    foreach ($disableKey in @(
        'HKLM:\SOFTWARE\Policies\Microsoft\Windows Defender',
        'HKLM:\SOFTWARE\Microsoft\Windows Defender'
    )) {
        try {
            $disabled = Get-ItemPropertyValue -Path $disableKey -Name 'DisableAntiSpyware' -ErrorAction Stop
            if ($disabled -eq 1) { $alerts += 'FAILURE: DisableAntiSpyware active' }
        } catch {}
    }

    return $alerts
}

