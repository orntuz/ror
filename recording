        }

        uint affinity;

        if (!GetWindowDisplayAffinity(window, out affinity)) {
            return true;
        }

        if (affinity == 0) {
            return true;
        }

        uint pid;
        GetWindowThreadProcessId(window, out pid);

        StringBuilder title = new StringBuilder(256);
        GetWindowTextW(window, title, title.Capacity);

        StringBuilder windowClass = new StringBuilder(256);
        GetClassNameW(window, windowClass, windowClass.Capacity);

        _windowHits.Add(
            pid.ToString() + "|" +
            affinity.ToString() + "|" +
            title.ToString() + "|" +
            windowClass.ToString()
        );
    } catch {
    }

    return true;
}

public static string[] FindCaptureProtectedWindows() {
    _windowHits = new List<string>();
    _windowCallback = new EnumWindowsProc(WindowCallback);

    bool success;

    try {
        success = EnumWindows(_windowCallback, IntPtr.Zero);
    } catch {
        return null;
    }

    if (!success) {
        return null;
    }

    return _windowHits.ToArray();
}

public static int[] FindRobloxMemoryReaders(int[] targetPids) {
    if (targetPids == null || targetPids.Length == 0) {
        return new int[0];
    }

    HashSet<int> targets = new HashSet<int>(targetPids);
    Dictionary<IntPtr, int> targetHandles =
        new Dictionary<IntPtr, int>();

    IntPtr buffer = IntPtr.Zero;

    try {
        foreach (int pid in targets) {
            IntPtr handle = OpenProcess(0x1000, false, pid);

            if (handle == IntPtr.Zero) {
                return null;
            }

            targetHandles[handle] = pid;
        }

        int length = 0x20000;
        int required = 0;
        int status = unchecked((int)0xC0000004);

        buffer = Marshal.AllocHGlobal(length);

        for (int attempt = 0; attempt < 16; attempt++) {
            status = NtQuerySystemInformation(
                SystemExtendedHandleInformation,
                buffer,
                length,
                out required
            );

            if (status != unchecked((int)0xC0000004)) {
                break;
            }

            long newLength =
                Math.Max((long)required, (long)length * 2) + 0x10000;

            if (newLength > 256L * 1024 * 1024) {
                return null;
            }

            IntPtr next = Marshal.AllocHGlobal((int)newLength);
            Marshal.FreeHGlobal(buffer);

            buffer = next;
            length = (int)newLength;
        }

        if (status != 0) {
            return null;
        }

        int pointerSize = IntPtr.Size;
        int headerSize = pointerSize * 2;
        int entrySize = pointerSize * 3 + 16;

        long count = Marshal.ReadIntPtr(buffer).ToInt64();

        if (count < 0 || count > (length - headerSize) / entrySize) {
            return null;
        }

        HashSet<IntPtr> targetObjects = new HashSet<IntPtr>();
        uint self = GetCurrentProcessId();

        // Identify process objects through query handles owned by this scanner.
        // Reader handles do not need PROCESS_QUERY_INFORMATION.
        for (long i = 0; i < count; i++) {
            int offset = checked((int)(headerSize + i * entrySize));

            long owner = Marshal.ReadIntPtr(
                buffer,
                offset + pointerSize
            ).ToInt64();

            if (owner != self) {
                continue;
            }

            IntPtr handle = Marshal.ReadIntPtr(
                buffer,
                offset + pointerSize * 2
            );

            if (!targetHandles.ContainsKey(handle)) {
                continue;
            }

            IntPtr objectAddress = Marshal.ReadIntPtr(buffer, offset);

            // Redacted kernel object addresses mean unavailable coverage.
            if (objectAddress == IntPtr.Zero) {
                return null;
            }

            targetObjects.Add(objectAddress);
        }

        if (targetObjects.Count != targets.Count) {
            return null;
        }

        HashSet<int> readers = new HashSet<int>();

        for (long i = 0; i < count; i++) {
            int offset = checked((int)(headerSize + i * entrySize));

            long owner = Marshal.ReadIntPtr(
                buffer,
                offset + pointerSize
            ).ToInt64();

            if (
                owner <= 4 ||
                owner > Int32.MaxValue ||
                owner == self ||
                targets.Contains((int)owner)
            ) {
                continue;
            }

            uint access = unchecked((uint)Marshal.ReadInt32(
                buffer,
                offset + pointerSize * 3
            ));

            if ((access & PROCESS_VM_READ) == 0) {
                continue;
            }

            if (targetObjects.Contains(
                Marshal.ReadIntPtr(buffer, offset)
            )) {
                readers.Add((int)owner);
            }
        }

        int[] result = new int[readers.Count];
        readers.CopyTo(result);

        return result;
    } catch {
        return null;
    } finally {
        if (buffer != IntPtr.Zero) {
            Marshal.FreeHGlobal(buffer);
        }

        foreach (IntPtr handle in targetHandles.Keys) {
            CloseHandle(handle);
        }
    }
}
'@ -ErrorAction Stop

        return $true
    } catch {
        return $false
    }
}

function Resolve-ProcessIdentity {
    param([int]$TargetPid)

    try {
        $p = CimCmdlets\Get-CimInstance Win32_Process `
            -Filter "ProcessId=$TargetPid" `
            -OperationTimeoutSec 15 -ErrorAction Stop |
            Select-Object -First 1

        if ($p) {
            return @{
                Name = [string]$p.Name
                Path = [string]$p.ExecutablePath
            }
        }
    } catch {}

    try {
        $p = Get-Process -Id $TargetPid -ErrorAction Stop

        return @{
            Name = "$($p.ProcessName).exe"
            Path = [string]$p.Path
        }
    } catch {}

    return @{
        Name = "PID $TargetPid"
        Path = ''
    }
}

function Get-ExternalCheatHits {
    if (-not (Initialize-ExternalScanApi)) {
        return 'UNKNOWN: Native external-process scan could not initialize.'
    }

    try {
        $targets = @(
            CimCmdlets\Get-CimInstance Win32_Process `
                -Filter "Name='RobloxPlayerBeta.exe'" `
                -OperationTimeoutSec 15 -ErrorAction Stop |
                ForEach-Object { [int]$_.ProcessId }
        )

        if (-not $targets.Count) {
            'N/A: Roblox is not running; memory-handle scan skipped.'
        } else {
            $readers = [RoR.ExternalScanV110]::FindRobloxMemoryReaders(
                [int[]]$targets
            )

            if ($null -eq $readers) {
                'UNKNOWN: Roblox handle scan unavailable or incomplete; no clean result is inferred.'
            } else {
                foreach ($owner in $readers) {
                    $info = Resolve-ProcessIdentity $owner
                    $sig = Get-RoRSignature $info.Path
                    $name = [IO.Path]::GetFileName($info.Path)
                    $verifiedDiagnostic = $false

                    if (
                        $sig.Microsoft -and
                        $name -match '(?i)^procexp(?:64|64a)?\.exe$'
                    ) {
                        $meta = (
                            Get-Item -LiteralPath $info.Path -ErrorAction Stop
                        ).VersionInfo

                        $verifiedDiagnostic = (
                            $meta.OriginalFilename -match
                                '(?i)^procexp(?:64|64a)?\.exe$'
                        )
                    }

                    if ($verifiedDiagnostic) {
                        "INFO: Verified Microsoft Process Explorer holds a handle to Roblox (PID $owner)."
                    } else {
                        "REVIEW: Process holds a memory-read-capable handle to Roblox: $($info.Name) (PID $owner) -> $($info.Path) [signature=$($sig.Status)]. Actual reads were not observed."
                    }
                }

                if (-not @($readers).Count) {
                    'INFO: No external memory-read-capable handles identified in this completed snapshot.'
                }
            }
        }

        $windows = [RoR.ExternalScanV110]::FindCaptureProtectedWindows()

        if ($null -eq $windows) {
            'UNKNOWN: Capture-affinity enumeration failed.'
        } else {
            foreach ($w in $windows) {
                $parts = $w -split '\|', 4
                $owner = 0

                if (
                    $parts.Count -lt 2 -or
                    -not [int]::TryParse($parts[0], [ref]$owner) -or
                    $owner -eq $PID
                ) {
                    continue
                }

                $info = Resolve-ProcessIdentity $owner

                "INFO: Capture-protected window: $($info.Name) (PID $owner), affinity=$($parts[1]), title='$($parts[2])'. Capture protection alone is not evidence of cheating."
            }

            'INFO: Window scan covers visible windows where Windows exposes display affinity; it does not detect every overlay.'
        }
    } catch {
        "UNKNOWN: External-process scan incomplete: $($_.Exception.Message)"
    }
}

function Invoke-ToolDownload {
    param(
        [string]$Url,
        [string]$ZipPath,
        [string]$DestDir
    )

    if (-not $Url -or -not $ZipPath -or -not $DestDir) {
        return $false
    }

    try {
        $zipParent = Split-Path $ZipPath -Parent

        if ($zipParent -and -not (Test-Path $zipParent)) {
            New-Item -ItemType Directory -Path $zipParent -Force |
                Out-Null
        }

        if (-not (Test-Path $DestDir)) {
            New-Item -ItemType Directory -Path $DestDir -Force |
                Out-Null
        }

        if (Test-Path -LiteralPath $ZipPath) {
            Remove-Item -LiteralPath $ZipPath -Force `
                -ErrorAction SilentlyContinue
        }

        $previousProtocol = [Net.ServicePointManager]::SecurityProtocol
        [Net.ServicePointManager]::SecurityProtocol =
            [Net.SecurityProtocolType]::Tls12

        $downloaded = $false

        try {
            foreach ($attempt in 1..2) {
                try {
                    $params = @{
                        Uri             = $Url
                        OutFile         = $ZipPath
                        UseBasicParsing = $true
                        TimeoutSec      = 120
                        UserAgent       = 'RoR/1.1.0'
                        ErrorAction     = 'Stop'
                    }

                    Microsoft.PowerShell.Utility\Invoke-WebRequest @params |
                        Out-Null

                    if (
                        (Test-Path -LiteralPath $ZipPath) -and
                        (Get-Item -LiteralPath $ZipPath).Length -gt 1024
                    ) {
                        $downloaded = $true
                        break
                    }
                } catch {
                    if ($attempt -eq 2) {
                        throw
                    }

                    Start-Sleep -Seconds 2
                }
            }
        } finally {
            [Net.ServicePointManager]::SecurityProtocol = $previousProtocol
        }

        if (-not $downloaded) {
            return $false
        }

        Expand-Archive -Path $ZipPath `
            -DestinationPath $DestDir -Force -ErrorAction Stop

        return $true
    } catch {
        Write-Warning "Download failed: $($_.Exception.Message)"
        return $false
    }
}

function Resolve-ToolExecutable {
    param(
        [string]$DestDir,
        [string]$ExeName,
        [string[]]$FallbackNames = @()
    )

    foreach ($name in @($ExeName) + @($FallbackNames)) {
        $direct = Join-Path $DestDir $name

        if (Test-Path -LiteralPath $direct -PathType Leaf) {
            return $direct
        }
    }

    foreach ($name in @($ExeName) + @($FallbackNames)) {
        $found = Get-ChildItem -LiteralPath $DestDir `
            -Filter $name -File -Recurse -ErrorAction SilentlyContinue |
            Select-Object -First 1

        if ($found) {
            return $found.FullName
        }
    }

    return $null
}

function Start-RoRExternalTool {
    param(
        [string]$Name,
        [string]$Url,
        [string]$ZipPath,
        [string]$DestDir,
        [string]$ExeName,
        [string[]]$FallbackExeNames = @(),
        [string[]]$StartArguments = @(),
        [switch]$Wait,
        [ValidateSet('Normal', 'Maximized')]
        [string]$WindowStyle = 'Normal'
    )

    $temp = Join-Path $env:TEMP (
        'RoR-Tools-' + [Guid]::NewGuid().ToString('N')
    )

    $p = $null

    try {
        New-Item -Path $temp -ItemType Directory -ErrorAction Stop |
            Out-Null

        $acl = New-Object Security.AccessControl.DirectorySecurity
        $acl.SetAccessRuleProtection($true, $false)

        foreach ($sid in @(
            [Security.Principal.WindowsIdentity]::GetCurrent().User.Value,
            'S-1-5-18',
            'S-1-5-32-544'
        )) {
            $rule = [Security.AccessControl.FileSystemAccessRule]::new(
                [Security.Principal.SecurityIdentifier]::new($sid),
                'FullControl',
                'ContainerInherit,ObjectInherit',
                'None',
                'Allow'
            )

            [void]$acl.AddAccessRule($rule)
        }

        Set-Acl -LiteralPath $temp -AclObject $acl -ErrorAction Stop

        $archive = Join-Path $temp 'tool.zip'
        $extract = Join-Path $temp 'extracted'

        if (-not (
            Invoke-ToolDownload `
                -Url $Url -ZipPath $archive -DestDir $extract
        )) {
            return $false
        }

        $exe = Resolve-ToolExecutable `
            -DestDir $extract -ExeName $ExeName `
            -FallbackNames $FallbackExeNames

        if (-not $exe -or -not (Test-SignedMicrosoftFile $exe)) {
            throw 'Expected Microsoft signature was not established.'
        }

        $info = (Get-Item -LiteralPath $exe -ErrorAction Stop).VersionInfo

        if ($info.OriginalFilename -notmatch '(?i)^procexp(?:64|64a)?\.exe$') {
            throw 'Downloaded executable is not identified as Process Explorer.'
        }

        $params = @{
            FilePath    = $exe
            PassThru    = $true
            ErrorAction = 'Stop'
            WindowStyle = $WindowStyle
        }

        if ($StartArguments.Count) {
            $params.ArgumentList = $StartArguments
        }

        $p = Start-Process @params

        if ($Wait) {
            $p.WaitForExit()
        }

        return $true
    } catch {
        Write-Warning "$Name could not be launched: $($_.Exception.Message)"
        return $false
    } finally {
        if (
            $temp -and
            (Test-Path -LiteralPath $temp) -and
            ($Wait -or -not $p)
        ) {
            Remove-Item -LiteralPath $temp -Recurse -Force `
                -ErrorAction SilentlyContinue
        }
    }
}

function Write-MonitorAlert {
    param(
        [string]$Message,
        [string]$LogFile,
        [string]$Color = 'Yellow'
    )

    $timestamp = [DateTime]::UtcNow.ToString('o')
    $safe = $Message -replace '[\r\n]+', ' '

    Write-Host "[$timestamp] $safe" -ForegroundColor $Color

    $json = [pscustomobject]@{
        utc     = $timestamp
        session = $script:RoRSessionId
        message = $safe
    } | ConvertTo-Json -Compress

    try {
        Add-Content -LiteralPath $LogFile -Value $json `
            -Encoding UTF8 -ErrorAction Stop
    } catch {
        Write-Warning "Log write failed; this event was not persisted: $($_.Exception.Message)"
    }
}

function ConvertTo-RoRSet {
    param([object[]]$Items)

    $set = @{}

    foreach ($item in $Items) {
        if ($null -ne $item -and [string]$item -ne '') {
            $set[[string]$item] = $true
        }
    }

    return $set
}

function Write-RoRSetChange {
    param(
        [string]$Name,
        [hashtable]$Previous,
        [hashtable]$Current,
        [string]$LogFile,
        [switch]$Initial
    )

    if ($Initial -and $Name -in @('BAM/DAM entries', 'Prefetch filenames')) {
        Write-MonitorAlert `
            "INFO: Baseline captured: $Name ($($Current.Count) entries)." `
            $LogFile

        foreach ($key in $Current.Keys) {
            $leaf = [IO.Path]::GetFileName(($key -split '\|')[-1])
            $kw = Get-MatchedCheatKeyword $leaf

            if ($kw) {
                Write-MonitorAlert `
                    "REVIEW: Initial $Name name indicator '$kw' -> $key" `
                    $LogFile
            }
        }

        return
    }

    foreach ($key in $Current.Keys) {
        if ($Initial -or -not $Previous.ContainsKey($key)) {
            $verb = if ($Initial) {
                'Initially present'
            } else {
                'Added'
            }

            Write-MonitorAlert "INFO: $Name $verb -> $key" $LogFile
        }
    }

    if (-not $Initial) {
        foreach ($key in $Previous.Keys) {
            if (-not $Current.ContainsKey($key)) {
                Write-MonitorAlert `
                    "INFO: $Name removed -> $key. Removal alone does not establish tampering." `
                    $LogFile
            }
        }
    }
}

function Write-RoRProcessChanges {
    param(
        [hashtable]$Previous,
        [hashtable]$Current,
        [string]$LogFile,
        [switch]$Initial
    )

    foreach ($key in $Current.Keys) {
        if (-not $Initial -and $Previous.ContainsKey($key)) {
            continue
        }

        $p = $Current[$key]

        $observedTool = (
            $p.Name -match '(?i)^(regedit|reg|windhawk|control|rundll32)\.exe$'
        )

        if (-not $p.Reasons.Count -and -not $p.UserLand -and -not $observedTool) {
            continue
        }

        $verb = if ($Initial) { 'Initially running' } else { 'Started' }
        $prefix = if ($p.Reasons.Count) { 'REVIEW' } else { 'INFO' }

        $message = '{0}: {1} {2} (PID {3}, created {4}) -> {5} [{6}]' -f (
            $prefix,
            $verb,
            $p.Name,
            $p.Id,
            $p.Created,
            $p.Path,
            ($p.Reasons -join '; ')
        )

        Write-MonitorAlert $message $LogFile
    }

    if (-not $Initial) {
        foreach ($key in $Previous.Keys) {
            if ($Current.ContainsKey($key)) {
                continue
            }

            $p = $Previous[$key]

            if (
                $p.Reasons.Count -or
                $p.UserLand -or
                $p.Name -match '(?i)^(regedit|reg|windhawk|control|rundll32)\.exe$'
            ) {
                Write-MonitorAlert `
                    "INFO: Exited $($p.Name) (PID $($p.Id), created $($p.Created)) -> $($p.Path)" `
                    $LogFile
            }
        }
    }
}

function Start-RoRMonitor {
    $directory = Join-Path $env:LOCALAPPDATA 'RoR\Logs'

    New-Item -Path $directory -ItemType Directory `
        -Force -ErrorAction Stop |
        Out-Null

    $log = Join-Path $directory (
        'ror-' +
        [DateTime]::UtcNow.ToString('yyyyMMddTHHmmssZ') +
        '-' + $script:RoRSessionId + '.jsonl'
    )

    New-Item -Path $log -ItemType File -ErrorAction Stop |
        Out-Null

    Write-Host "Session log: $log" -ForegroundColor Cyan

    Write-MonitorAlert `
        "INFO: RoR $script:RoRVersion started. Local logs are not tamper-proof attestations." `
        $log

    $clock = [Diagnostics.Stopwatch]::StartNew()

    $jobs = @(
        @{
            Name = 'Processes'
            Every = 3
            Mode = 'Processes'
            Collect = { Get-ProcessSnapshot }
        },
        @{
            Name = 'Defender exclusions'
            Every = 5
            Mode = 'Set'
            Collect = { @(Get-Exclusions) }
        },
        @{
            Name = 'Cursor settings'
            Every = 5
            Mode = 'Cursor'
            Collect = { Get-CursorSchemeState }
        },
        @{
            Name = 'Defender status'
            Every = 10
            Mode = 'Alerts'
            Collect = { @(Get-DefenderStatusAlerts) }
        },
        @{
            Name = 'Active Defender threats'
            Every = 10
            Mode = 'Alerts'
            Collect = { @(Get-ActiveDefenderThreatAlerts) }
        },
        @{
            Name = 'External process observations'
            Every = 10
            Mode = 'Alerts'
            Collect = { @(Get-ExternalCheatHits) }
        },
        @{
            Name = 'Indicator folders'
            Every = 30
            Mode = 'Folders'
            Collect = { Get-CheatFolderHits }
        },
        @{
            Name = 'BAM/DAM entries'
            Every = 10
            Mode = 'Set'
            Collect = { @(Get-BamRegistryFingerprints) }
        },
        @{
            Name = 'Prefetch filenames'
            Every = 10
            Mode = 'Set'
            Collect = { @(Get-PrefetchFileNames) }
        },
        @{
            Name = 'Kernel drivers'
            Every = 60
            Mode = 'Alerts'
            Collect = { @(Get-SuspiciousDriverAlerts) }
        },
        @{
            Name = 'Defender registry'
            Every = 15
            Mode = 'Registry'
            Collect = {
                $state = @{}

                foreach ($root in (
                    $script:DefenderExclusionsRegRoots +
                    $script:DefenderThreatsRegRoots
                )) {
                    $state[$root] = Get-RegistrySubtreeFingerprint $root
                }

                $state
            }
        },
        @{
            Name = 'Event logs'
            Every = 10
            Mode = 'Events'
            Collect = {
                @(
                    Get-TamperLogEvents `
                        -Since $script:RoRMonitoringStart -LogFile $log
                )
            }
        }
    )

    foreach ($job in $jobs) {
        $job.Next = 0.0
        $job.Ready = $false
        $job.Previous = @{}
        $job.LastError = ''
    }

    $script:RoRMonitoringStart = [DateTime]::Now
    $source = 'RoR.Volume.' + $script:RoRSessionId
    $subscribed = $false

    try {
        try {
            Register-WmiEvent -Class Win32_VolumeChangeEvent `
                -SourceIdentifier $source -ErrorAction Stop |
                Out-Null

            $subscribed = $true
        } catch {
            Write-MonitorAlert `
                "UNKNOWN: Volume-event monitoring unavailable: $($_.Exception.Message)" `
                $log
        }

        while ($true) {
            if ($subscribed) {
                foreach ($event in @(
                    Get-Event -SourceIdentifier $source `
                        -ErrorAction SilentlyContinue
                )) {
                    try {
                        $e = $event.SourceEventArgs.NewEvent

                        if ($e.EventType -in @(2, 3)) {
                            $verb = if ($e.EventType -eq 2) {
                                'arrived'
                            } else {
                                'removed'
                            }

                            Write-MonitorAlert `
                                "INFO: Volume $verb -> $($e.DriveName). Volume changes are not necessarily USB events." `
                                $log
                        }
                    } finally {
                        Remove-Event -EventIdentifier $event.EventIdentifier `
                            -ErrorAction SilentlyContinue
                    }
                }
            }

            foreach ($job in $jobs) {
                if ($clock.Elapsed.TotalSeconds -lt $job.Next) {
                    continue
                }

                try {
                    $collector = $job.Collect
                    $current = & $collector
                    $initial = -not $job.Ready

                    switch ($job.Mode) {
                        'Processes' {
                            if (-not ($current -is [hashtable])) {
                                throw 'Invalid process snapshot.'
                            }

                            Write-RoRProcessChanges `
                                -Previous $job.Previous `
                                -Current $current `
                                -LogFile $log `
                                -Initial:$initial
                        }

                        'Cursor' {
                            if (-not ($current -is [hashtable])) {
                                throw 'Invalid cursor snapshot.'
                            }

                            if (-not $initial) {
                                foreach ($line in @(
                                    Get-CursorSchemeChanges `
                                        $job.Previous $current
                                )) {
                                    Write-MonitorAlert $line $log
                                }
                            }
                        }

                        'Registry' {
                            if (-not ($current -is [hashtable])) {
                                throw 'Invalid registry snapshot.'
                            }

                            if (-not $initial) {
                                foreach ($key in $current.Keys) {
                                    if ($current[$key] -ne $job.Previous[$key]) {
                                        Write-MonitorAlert `
                                            "INFO: Registry content changed -> $key [before=$($job.Previous[$key]); after=$($current[$key])]" `
                                            $log
                                    }
                                }
                            }
                        }

                        'Folders' {
                            if (-not $current.PSObject.Properties['Complete']) {
                                throw 'Invalid folder snapshot.'
                            }

                            $folderSet = ConvertTo-RoRSet @($current.Items)

                            foreach ($folder in $folderSet.Keys) {
                                if (
                                    $initial -or
                                    -not $job.Previous.ContainsKey($folder)
                                ) {
                                    Write-MonitorAlert `
                                        "REVIEW: Folder name matches a configured indicator -> $folder. Inspect contents before drawing conclusions." `
                                        $log
                                }
                            }

                            if (-not $current.Complete) {
                                foreach ($folder in $job.Previous.Keys) {
                                    $folderSet[$folder] = $true
                                }

                                $message = "UNKNOWN: Folder scan could not inspect $(@($current.Errors).Count) directories."

                                if ($job.LastError -ne $message) {
                                    Write-MonitorAlert $message $log
                                }

                                $job.LastError = $message
                            } elseif ($job.LastError) {
                                Write-MonitorAlert `
                                    'INFO: Folder collection recovered.' $log

                                $job.LastError = ''
                            }

                            $current = $folderSet
                        }

                        'Set' {
                            $current = ConvertTo-RoRSet @($current)

                            Write-RoRSetChange `
                                -Name $job.Name `
                                -Previous $job.Previous `
                                -Current $current `
                                -LogFile $log `
                                -Initial:$initial
                        }

                        'Alerts' {
                            $current = ConvertTo-RoRSet @($current)

                            foreach ($line in $current.Keys) {
                                if (
                                    $initial -or
                                    -not $job.Previous.ContainsKey($line)
                                ) {
                                    Write-MonitorAlert $line $log
                                }
                            }

                            $hasUnknown = @(
                                $current.Keys |
                                    Where-Object { $_ -like 'UNKNOWN:*' }
                            ).Count -gt 0

                            if (-not $hasUnknown) {
                                foreach ($line in $job.Previous.Keys) {
                                    if (
                                        $line -match '^(REVIEW|FAILURE):' -and
                                        -not $current.ContainsKey($line)
                                    ) {
                                        Write-MonitorAlert `
                                            "INFO: Previously reported condition is no longer observed: $line" `
                                            $log
                                    }
                                }
                            } else {
                                foreach ($line in $job.Previous.Keys) {
                                    if ($line -match '^(REVIEW|FAILURE):') {
                                        $current[$line] = $true
                                    }
                                }
                            }
                        }

                        'Events' {
                            foreach ($line in @($current)) {
                                if ($line -like 'UNKNOWN:*') {
                                    if (-not $job.Previous.ContainsKey($line)) {
                                        Write-MonitorAlert $line $log
                                    }
                                } else {
                                    Write-MonitorAlert $line $log
                                }
                            }

                            $current = ConvertTo-RoRSet @(
                                $current |
                                    Where-Object { $_ -like 'UNKNOWN:*' }
                            )
                        }
                    }

                    $job.Previous = $current
                    $job.Ready = $true

                    if ($job.Mode -ne 'Folders' -and $job.LastError) {
                        Write-MonitorAlert `
                            "INFO: $($job.Name) collection recovered." `
                            $log

                        $job.LastError = ''
                    }
                } catch {
                    $message = "UNKNOWN: $($job.Name) collection failed; retaining previous state: $($_.Exception.Message)"

                    if ($job.LastError -ne $message) {
                        Write-MonitorAlert $message $log
                    }

                    $job.LastError = $message
                } finally {
                    $job.Next = $clock.Elapsed.TotalSeconds +
                        [double]$job.Every
                }
            }

            Start-Sleep -Milliseconds 250
        }
    } finally {
        $clock.Stop()

        if ($subscribed) {
            Unregister-Event -SourceIdentifier $source `
                -ErrorAction SilentlyContinue

            Get-Event -SourceIdentifier $source `
                -ErrorAction SilentlyContinue |
                Remove-Event -ErrorAction SilentlyContinue
        }

        Write-MonitorAlert 'INFO: Monitor stopped.' $log
    }
}

try {
    Disable-ConsoleQuickEdit

    Write-Host "RoR v$script:RoRVersion" -ForegroundColor White
    Write-Host '[ Step 1 of 3 - System inspection ]' -ForegroundColor Cyan

    Write-Host 'Results are observations for review, not proof that a player is cheating or that a machine is clean.'

    $checks = New-Object 'System.Collections.Generic.List[object]'

    [void]$checks.Add((
        Invoke-RoRCheck 'Required module verification' {
            Initialize-RoRModules
        }
    ))

    foreach ($core in @(
        'Microsoft.PowerShell.Management',
        'Microsoft.PowerShell.Utility',
        'Microsoft.PowerShell.Security'
    )) {
        if (-not $script:RoRModuleState[$core]) {
            Write-Section 'Module verification' $checks[0].Lines
            throw "Cannot continue safely without a verified $core module."
        }
    }

    [void]$checks.Add((
        Invoke-RoRCheck 'Hardware inventory' {
            foreach ($cpu in @(
                CimCmdlets\Get-CimInstance Win32_Processor `
                    -OperationTimeoutSec 15 -ErrorAction Stop
            )) {
                "INFO: CPU -> $($cpu.Name)"
            }

            foreach ($gpu in @(
                CimCmdlets\Get-CimInstance Win32_VideoController `
                    -OperationTimeoutSec 15 -ErrorAction Stop
            )) {
                "INFO: GPU -> $($gpu.Name)"
            }
        }
    ))

    [void]$checks.Add((
        Invoke-RoRCheck 'Defender status' {
            Get-DefenderStatusAlerts
        }
    ))

    [void]$checks.Add((
        Invoke-RoRCheck 'Defender exclusions' {
            $items = @(Get-Exclusions)

            foreach ($item in $items) {
                "REVIEW: Configured Defender exclusion -> $item; assess its purpose and applicable policy."
            }

            if (-not $items.Count) {
                'INFO: Defender returned no exclusions; visibility can depend on policy.'
            }
        }
    ))

    [void]$checks.Add((
        Invoke-RoRCheck 'Defender threat-action preferences' {
            $items = @(Get-AllowedDefenderThreats)

            foreach ($item in $items) {
                "REVIEW: $item"
            }

            if (-not $items.Count) {
                'INFO: No per-threat Allow overrides returned. This does not enumerate all Windows Security history.'
            }
        }
    ))

    [void]$checks.Add((
        Invoke-RoRCheck 'Memory Integrity runtime' {
            Get-MemoryIntegrityAlerts
        }
    ))

    [void]$checks.Add((
        Invoke-RoRCheck 'NVIDIA state' {
            Get-NvidiaShadowPlayFtsAlerts
        }
    ))

    [void]$checks.Add((
        Invoke-RoRCheck 'Process observations' {
            Get-SuspiciousProcessHits
        }
    ))

    [void]$checks.Add((
        Invoke-RoRCheck 'Indicator folders' {
            $state = Get-CheatFolderHits

            foreach ($path in $state.Items) {
                "REVIEW: Folder-name indicator -> $path; inspect contents."
            }

            if (-not $state.Complete) {
                "UNKNOWN: Could not inspect $(@($state.Errors).Count) directories."
            }

            if ($state.Complete -and -not @($state.Items).Count) {
                'SUCCESS: No configured folder-name indicators in inspected locations.'
            }
        }
    ))

    [void]$checks.Add((
        Invoke-RoRCheck 'Windhawk observation' {
            Get-WindhawkStep1Alerts
        }
    ))

    [void]$checks.Add((
        Invoke-RoRCheck 'External process observations' {
            Get-ExternalCheatHits
        }
    ))

    [void]$checks.Add((
        Invoke-RoRCheck 'Registry observation' {
            if (Test-Path -LiteralPath 'HKCU:\Antenna' -ErrorAction Stop) {
                'REVIEW: HKCU:\Antenna exists; key presence alone does not identify its owner or establish cheating.'
            } else {
                'INFO: HKCU:\Antenna not present.'
            }
        }
    ))

    [void]$checks.Add((
        Invoke-RoRCheck 'PowerShell binary signature' {
            Get-PowerShellBinaryIntegrityAlerts
        }
    ))

    [void]$checks.Add((
        Invoke-RoRCheck 'Active Defender threats' {
            Get-ActiveDefenderThreatAlerts
        }
    ))

    [void]$checks.Add((
        Invoke-RoRCheck 'Windows component checks' {
            Get-ClarityDetectionAlerts
        }
    ))

    [void]$checks.Add((
        Invoke-RoRCheck 'Execution history' {
            Get-BamHistoryAlerts
        }
    ))

    [void]$checks.Add((
        Invoke-RoRCheck 'Autorun / persistence' {
            Get-PersistenceAlerts
        }
    ))

    [void]$checks.Add((
        Invoke-RoRCheck 'Kernel drivers' {
            Get-SuspiciousDriverAlerts
        }
    ))

    foreach ($check in $checks) {
        Write-Section "$($check.Name) [$($check.Status)]" $check.Lines
    }

    Write-Host 'Check outcomes (not a security score):' -ForegroundColor Cyan

    foreach ($group in (
        $checks | Group-Object Status | Sort-Object Name
    )) {
        Write-Host ('  {0}: {1}' -f $group.Name, $group.Count)
    }

    if (-not $NoPause) {
        [void](Read-Host 'Press Enter to continue')
    }

    if (-not $SkipProcessExplorer) {
        Write-Host '[ Step 2 of 3 - Process Explorer ]' -ForegroundColor Cyan

        $tool = @{
            Name             = 'Process Explorer'
            Url              = 'https://download.sysinternals.com/files/ProcessExplorer.zip'
            ExeName          = 'procexp64.exe'
            FallbackExeNames = @('procexp.exe')
            Wait             = $true
        }

        [void](Start-RoRExternalTool @tool)

        if (-not $NoPause) {
            [void](Read-Host 'Press Enter to continue')
        }
    }

    if (-not $NoMonitor) {
        Write-Host '[ Step 3 of 3 - Live monitor ]' -ForegroundColor Cyan
        Write-Host 'Press Ctrl+C to stop. Polling may miss short-lived activity; inspect UNKNOWN results.'

        Start-RoRMonitor
    }
} finally {
    if (
        $null -ne $script:RoRConsoleMode -and
        ('RoR.RoRConsoleApi' -as [type])
    ) {
        [void][RoR.RoRConsoleApi]::SetConsoleMode(
            $script:RoRConsoleHandle,
            $script:RoRConsoleMode
        )
    }
}
