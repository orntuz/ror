function Get-CheatFolderHits {
    $roots = @(
        (Join-Path $env:USERPROFILE 'Downloads'),
        [Environment]::GetFolderPath('Desktop'),
        $env:LOCALAPPDATA,
        $env:APPDATA,
        $env:ProgramData,
        $env:TEMP,
        ($env:SystemDrive + '\')
    ) | Select-Object -Unique

    $seen = New-Object 'System.Collections.Generic.HashSet[string]' (
        [StringComparer]::OrdinalIgnoreCase
    )

    $errors = New-Object 'System.Collections.Generic.List[string]'

    foreach ($root in $roots) {
        if (
            -not $root -or
            -not (Test-Path -LiteralPath $root -ErrorAction Stop)
        ) {
            continue
        }

        $queue = New-Object 'System.Collections.Generic.Queue[object]'
        $queue.Enqueue(@{ Path = $root; Depth = 0 })

        $limit = if ($root -eq ($env:SystemDrive + '\')) {
            1
        } else {
            2
        }

        while ($queue.Count) {
            $entry = $queue.Dequeue()

            try {
                $children = @(
                    Get-ChildItem -LiteralPath $entry.Path `
                        -Directory -Force -ErrorAction Stop
                )
            } catch {
                [void]$errors.Add($entry.Path)
                continue
            }

            foreach ($child in $children) {
                if (Get-MatchedCheatKeyword $child.Name -FolderName) {
                    [void]$seen.Add($child.FullName)
                }

                if (
                    $entry.Depth -lt $limit -and
                    -not ($child.Attributes -band [IO.FileAttributes]::ReparsePoint)
                ) {
                    $queue.Enqueue(@{
                        Path  = $child.FullName
                        Depth = $entry.Depth + 1
                    })
                }
            }
        }
    }

    [pscustomobject]@{
        Items    = @($seen)
        Errors   = @($errors.ToArray())
        Complete = ($errors.Count -eq 0)
    }
}

function Get-BamHistoryAlerts {
    $rootsRead = 0
    $entries = 0
    $findings = 0

    foreach ($root in @(
        'SYSTEM\CurrentControlSet\Services\bam\State\UserSettings',
        'SYSTEM\CurrentControlSet\Services\dam\State\UserSettings'
    )) {
        try {
            $key = Open-LocalMachineRegistryKey $root

            if (-not $key) {
                continue
            }

            $rootsRead++

            try {
                foreach ($sid in $key.GetSubKeyNames()) {
                    $sub = $key.OpenSubKey($sid)

                    if (-not $sub) {
                        throw "Key changed during enumeration: $sid"
                    }

                    try {
                        foreach ($name in $sub.GetValueNames()) {
                            $raw = $sub.GetValue($name)

                            if (
                                -not ($raw -is [byte[]]) -or
                                $raw.Length -lt 8
                            ) {
                                continue
                            }

                            $entries++

                            $kw = Get-MatchedCheatKeyword (
                                [IO.Path]::GetFileNameWithoutExtension($name)
                            )

                            if (-not $kw) {
                                continue
                            }

                            $at = 'unavailable'

                            try {
                                $at = [DateTime]::FromFileTimeUtc(
                                    [BitConverter]::ToInt64($raw, 0)
                                ).ToString('o')
                            } catch {}

                            "REVIEW: Historical execution name matches '$kw'; last recorded UTC=$at -> $name [user=$sid]. History alone is not proof of cheating."
                            $findings++
                        }
                    } finally {
                        $sub.Dispose()
                    }
                }
            } finally {
                $key.Dispose()
            }
        } catch {
            "UNKNOWN: Execution history incomplete at $root [$($_.Exception.Message)]"
        }
    }

    if (-not $rootsRead) {
        'N/A: BAM/DAM history keys are not present; no clean-history claim is made.'
    } elseif (-not $findings) {
        "SUCCESS: No configured name indicators in $entries inspected BAM/DAM entries."
    }
}

function Get-BamRegistryFingerprints {
    foreach ($root in @(
