function Disable-ConsoleQuickEdit {
    try {
        if (-not ('RoR.RoRConsoleApi' -as [type])) {
            Add-Type -Namespace RoR -Name RoRConsoleApi -MemberDefinition @'
[DllImport("kernel32.dll", SetLastError = true)]
public static extern IntPtr GetStdHandle(int nStdHandle);

[DllImport("kernel32.dll", SetLastError = true)]
public static extern bool GetConsoleMode(IntPtr handle, out uint mode);

[DllImport("kernel32.dll", SetLastError = true)]
public static extern bool SetConsoleMode(IntPtr handle, uint mode);
'@ -ErrorAction Stop
        }

        $handle = [RoR.RoRConsoleApi]::GetStdHandle(-10)
        [uint32]$mode = 0

        if ([RoR.RoRConsoleApi]::GetConsoleMode($handle, [ref]$mode)) {
            $script:RoRConsoleHandle = $handle
            $script:RoRConsoleMode = $mode

            [void][RoR.RoRConsoleApi]::SetConsoleMode(
                $handle,
                ($mode -bor 0x0080) -band (-bnot 0x0040)
            )
        }
    } catch {
        Write-Verbose 'Console mode could not be adjusted.'
    }
}

function Write-Section {
    param($Title, $Lines)

    Write-Host "--- $Title ---" -ForegroundColor Cyan

    foreach ($line in $Lines) {
        $color = 'Gray'

        if ($line -like 'SUCCESS:*') {
            $color = 'Green'
        } elseif ($line -like 'FAILURE:*') {
            $color = 'Red'
        } elseif (
            $line -like 'WARNING:*' -or
            $line -like 'REVIEW:*' -or
            $line -like 'UNKNOWN:*'
        ) {
            $color = 'Yellow'
        } elseif (
            $line -like 'INFO:*' -or
            $line -like 'N/A:*'
        ) {
            $color = 'DarkGray'
        }

        Write-Host $line -ForegroundColor $color
    }

    Write-Host ''
}

function Invoke-RoRCheck {
    param(
        [string]$Name,
        [scriptblock]$Action
    )

    $lines = New-Object 'System.Collections.Generic.List[string]'

    try {
        $ErrorActionPreference = 'Stop'

        & $Action | ForEach-Object {
            if ($null -ne $_) {
                [void]$lines.Add([string]$_)
            }
        }
    } catch {
        [void]$lines.Add(
            "UNKNOWN: Collection failed: $($_.Exception.Message)"
        )
    }

    if ($lines.Count -eq 0) {
        [void]$lines.Add('UNKNOWN: Check produced no result.')
    }

    $status = 'Info'

    if (@($lines | Where-Object { $_ -like 'FAILURE:*' }).Count) {
        $status = 'Failure'
    } elseif (@($lines | Where-Object { $_ -like 'UNKNOWN:*' }).Count) {
        $status = 'Unknown'
    } elseif (@(
        $lines | Where-Object {
            $_ -like 'REVIEW:*' -or $_ -like 'WARNING:*'
        }
    ).Count) {
        $status = 'Review'
    } elseif (@($lines | Where-Object { $_ -like 'SUCCESS:*' }).Count) {
        $status = 'Pass'
    }

    [pscustomobject]@{
        Name   = $Name
        Status = $status
        Lines  = @($lines.ToArray())
    }
}

function Get-RoRSignature {
    param([string]$Path)

    try {
        $file = Microsoft.PowerShell.Management\Get-Item `
            -LiteralPath $Path -Force -ErrorAction Stop

        if ($file.PSIsContainer) {
            throw 'Expected a file.'
        }

        $sig = Microsoft.PowerShell.Security\Get-AuthenticodeSignature `
            -LiteralPath $file.FullName -ErrorAction Stop

        $subject = if ($sig.SignerCertificate) {
            [string]$sig.SignerCertificate.Subject
        } else {
            ''
        }

        [pscustomobject]@{
            Status    = [string]$sig.Status
            Publisher = $subject
            Microsoft = (
                $sig.Status -eq 'Valid' -and
                $subject -match
                    '(?i)(^|,\s*)O="?Microsoft Corporation"?(,|$)'
            )
            Error = ''
        }
    } catch {
        [pscustomobject]@{
            Status    = 'Unavailable'
            Publisher = ''
            Microsoft = $false
            Error     = $_.Exception.Message
        }
    }
}

function Test-SignedMicrosoftFile {
    param([string]$Path)

    if ([string]::IsNullOrWhiteSpace($Path)) {
        return $false
    }

    return [bool](Get-RoRSignature $Path).Microsoft
}

function Normalize-ProcessImagePath {
    param([string]$ExecutablePath)

    if ([string]::IsNullOrWhiteSpace($ExecutablePath)) {
        return $null
    }

    $path = [Environment]::ExpandEnvironmentVariables(
        $ExecutablePath.Trim().Trim('"')
    ).Replace('/', '\')

    if (
        $path.StartsWith('\??\', [StringComparison]::OrdinalIgnoreCase) -or
        $path.StartsWith('\\?\', [StringComparison]::OrdinalIgnoreCase)
    ) {
        $path = $path.Substring(4)
    }

    try {
        if ([IO.Path]::IsPathRooted($path)) {
            $path = [IO.Path]::GetFullPath($path)
        }
    } catch {}

    return $path.TrimEnd('\')
}

function Test-RoRPathWithin {
    param(
        [string]$Path,
        [string]$Root
    )

    $p = Normalize-ProcessImagePath $Path
    $r = Normalize-ProcessImagePath $Root

    if (-not $p -or -not $r) {
        return $false
    }

    return $p.StartsWith(
        $r.TrimEnd('\') + '\',
        [StringComparison]::OrdinalIgnoreCase
    )
}

function Initialize-RoRModules {
    $script:DefenderAvailable = $false

    $names = @(
        'Microsoft.PowerShell.Management',
        'Microsoft.PowerShell.Utility',
        'Microsoft.PowerShell.Security',
        'Microsoft.PowerShell.Diagnostics',
        'Microsoft.PowerShell.Archive',
        'CimCmdlets',
        'ScheduledTasks',
        'Defender'
    )

    $roots = @(
        (Join-Path $PSHOME 'Modules'),
        (Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\Modules')
    ) | Select-Object -Unique

    foreach ($name in $names) {
        $script:RoRModuleState[$name] = $false

        try {
            $candidates = @(
                Microsoft.PowerShell.Core\Get-Module `
                    -ListAvailable -Name $name -ErrorAction Stop
            )

            $module = $null

            foreach ($candidate in ($candidates | Sort-Object Version -Descending)) {
                foreach ($root in $roots) {
                    if (Test-RoRPathWithin -Path $candidate.Path -Root $root) {
                        $module = $candidate
                        break
                    }
                }

                if ($module) {
                    break
                }
            }

            if (-not $module) {
                throw 'No module found in an expected Windows/PowerShell module directory.'
            }

            $files = @(
                Microsoft.PowerShell.Management\Get-ChildItem `
                    -LiteralPath $module.ModuleBase `
                    -File -Recurse -ErrorAction Stop |
                    Where-Object {
                        $_.Extension -match '(?i)^\.(ps1|psm1|psd1|dll|cdxml)$'
                    }
            )

            if (-not $files.Count) {
                throw 'No verifiable module files found.'
            }

            foreach ($file in $files) {
                if (-not (Test-SignedMicrosoftFile $file.FullName)) {
                    throw "Microsoft signature not established: $($file.FullName)"
                }
            }

            Microsoft.PowerShell.Core\Import-Module `
                -Name $module.Path -Force -ErrorAction Stop |
                Out-Null

            $script:RoRModuleState[$name] = $true
            "SUCCESS: Verified required module -> $name"
        } catch {
            "UNKNOWN: Required module $name unavailable or unverified: $($_.Exception.Message)"
        }
    }

    if ($script:RoRModuleState['Defender']) {
        $missing = @(
            'Get-MpComputerStatus',
            'Get-MpPreference',
            'Get-MpThreat'
        ) | Where-Object {
            -not (
                Microsoft.PowerShell.Core\Get-Command `
                    -Name "Defender\$_" -ErrorAction SilentlyContinue
            )
        }

        $script:DefenderAvailable = (@($missing).Count -eq 0)
    }

    $script:PSModuleAutoLoadingPreference = 'None'
}

function Open-LocalMachineRegistryKey {
    param([string]$SubKeyPath)

    $base = [Microsoft.Win32.RegistryKey]::OpenBaseKey(
        [Microsoft.Win32.RegistryHive]::LocalMachine,
        [Microsoft.Win32.RegistryView]::Registry64
    )

    if ([string]::IsNullOrWhiteSpace($SubKeyPath)) {
        return $base
    }

    try {
        return $base.OpenSubKey($SubKeyPath, $false)
    } finally {
        $base.Dispose()
    }
}

function Add-RegistryKeyFingerprint {
    param(
        [Microsoft.Win32.RegistryKey]$Key,
        [string]$Prefix,
        [System.Collections.Generic.List[string]]$Parts
    )

    foreach ($name in $Key.GetValueNames()) {
        $value = $Key.GetValue(
            $name,
            $null,
            [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames
        )

        $encoded = ConvertTo-Json -InputObject $value -Compress -Depth 10

        [void]$Parts.Add((
            ConvertTo-Json -InputObject @(
                $Prefix,
                $name,
                [string]$Key.GetValueKind($name),
                $encoded
            ) -Compress
        ))
    }

    foreach ($name in $Key.GetSubKeyNames()) {
        $sub = $Key.OpenSubKey($name)

        if (-not $sub) {
            throw "Registry changed during enumeration: $Prefix\$name"
        }

        try {
            Add-RegistryKeyFingerprint `
                -Key $sub -Prefix "$Prefix\$name" -Parts $Parts
        } finally {
            $sub.Dispose()
        }
    }
}

function Get-RegistrySubtreeFingerprint {
    param([string]$RelativePath)

    $root = Open-LocalMachineRegistryKey $RelativePath

    if (-not $root) {
        return 'MISSING'
    }

    $parts = New-Object 'System.Collections.Generic.List[string]'

    try {
        Add-RegistryKeyFingerprint `
            -Key $root -Prefix $RelativePath -Parts $parts
    } finally {
        $root.Dispose()
    }

    $sha = [Security.Cryptography.SHA256]::Create()

    try {
        $text = ($parts | Sort-Object) -join [Environment]::NewLine
        $bytes = [Text.Encoding]::UTF8.GetBytes($text)
        return ([BitConverter]::ToString(
            $sha.ComputeHash($bytes)
        )).Replace('-', '')
    } finally {
        $sha.Dispose()
    }
}

function Get-RoRDefenderPreferences {
    if (-not $script:DefenderAvailable) {
        throw 'Defender module unavailable.'
    }

    $p = Defender\Get-MpPreference -ErrorAction Stop

    if ($null -eq $p) {
        throw 'Defender returned no preferences.'
    }

    return $p
}

function Get-Exclusions {
    $prefs = Get-RoRDefenderPreferences

    foreach ($property in @(
        'ExclusionPath',
        'ExclusionProcess',
        'ExclusionExtension',
        'ExclusionIpAddress'
    )) {
        if (-not $prefs.PSObject.Properties[$property]) {
            continue
        }

        foreach ($item in @($prefs.$property)) {
            if (-not [string]::IsNullOrWhiteSpace([string]$item)) {
                "$property=$item"
            }
        }
    }
}

function Get-AllowedDefenderThreats {
    $prefs = Get-RoRDefenderPreferences

    if (
        -not $prefs.PSObject.Properties['ThreatIDDefaultAction_Ids'] -or
        -not $prefs.PSObject.Properties['ThreatIDDefaultAction_Actions']
    ) {
        throw 'Defender does not expose per-threat action preferences on this host.'
    }

    $ids = @(
        $prefs.ThreatIDDefaultAction_Ids |
            Where-Object { $null -ne $_ }
    )

    $actions = @(
        $prefs.ThreatIDDefaultAction_Actions |
            Where-Object { $null -ne $_ }
    )

    if ($ids.Count -ne $actions.Count) {
        throw 'Defender returned mismatched threat-action arrays.'
    }

    for ($i = 0; $i -lt $ids.Count; $i++) {
        if ([int]$actions[$i] -eq 6) {
            "ThreatID=$($ids[$i]); configured action=Allow"
        }
    }
}

function Get-DefenderStatusAlerts {
    if (-not $script:DefenderAvailable) {
        return 'UNKNOWN: Defender module/cmdlets unavailable.'
    }

    try {
        $s = Defender\Get-MpComputerStatus -ErrorAction Stop

        if (-not $s) {
            throw 'Defender returned no status.'
        }

        if ($s.PSObject.Properties['AMRunningMode']) {
            "INFO: Defender operating mode: $($s.AMRunningMode)"
        }

        if ($s.RealTimeProtectionEnabled) {
            'SUCCESS: Defender real-time protection is running.'
        } else {
            'REVIEW: Defender real-time protection is not running; check antivirus mode and local policy.'
        }

        if ($s.PSObject.Properties['IsTamperProtected']) {
            if ($s.IsTamperProtected) {
                'SUCCESS: Defender tamper protection enabled.'
            } else {
                'REVIEW: Defender tamper protection disabled; this is not evidence of cheating.'
            }
        } else {
            'UNKNOWN: Tamper protection status unavailable.'
        }
    } catch {
        "UNKNOWN: Defender status unavailable: $($_.Exception.Message)"
    }
}

function Get-ActiveDefenderThreatAlerts {
    if (-not $script:DefenderAvailable) {
        return 'UNKNOWN: Defender threat query unavailable.'
    }

    try {
        $all = @(Defender\Get-MpThreat -ErrorAction Stop)

        foreach ($item in $all) {
            if (-not $item.PSObject.Properties['IsActive']) {
                throw 'Unexpected Defender threat schema: IsActive missing.'
            }
        }

        $active = @($all | Where-Object { $_.IsActive -eq $true })

        if (-not $active.Count) {
            'SUCCESS: Defender reports no active threats; this is not a fresh antivirus scan.'
        }

        foreach ($item in $active) {
            "FAILURE: Defender reports an active threat: $($item.ThreatName) [ID=$($item.ThreatID)] -> $(@($item.Resources) -join '; ')"
        }
    } catch {
        "UNKNOWN: Defender threat query failed: $($_.Exception.Message)"
    }
}

function Get-MemoryIntegrityAlerts {
    try {
        $params = @{
            Namespace           = 'root\Microsoft\Windows\DeviceGuard'
            ClassName           = 'Win32_DeviceGuard'
            OperationTimeoutSec = 15
            ErrorAction         = 'Stop'
        }

        $dg = CimCmdlets\Get-CimInstance @params

        if (-not $dg) {
            throw 'Win32_DeviceGuard returned no instance.'
        }

        if (@($dg.SecurityServicesRunning) -contains 2) {
            'SUCCESS: Memory Integrity (HVCI) is running.'
        } elseif (@($dg.SecurityServicesConfigured) -contains 2) {
            'REVIEW: HVCI is configured but not running.'
        } else {
            'INFO: HVCI is not configured/running; evaluate against the applicable security policy.'
        }
    } catch {
        "UNKNOWN: HVCI runtime status unavailable: $($_.Exception.Message)"
    }
}

function Get-PowerShellBinaryIntegrityAlerts {
    $path = Join-Path $PSHOME 'powershell.exe'
    $sig = Get-RoRSignature $path

    if ($sig.Microsoft) {
        "SUCCESS: Microsoft Authenticode signature valid for host executable -> $path"
    } elseif ($sig.Status -eq 'HashMismatch') {
        "FAILURE: PowerShell executable signature hash mismatch -> $path"
    } elseif ($sig.Status -eq 'Valid') {
        "REVIEW: PowerShell host has a different verified publisher -> $path [$($sig.Publisher)]"
    } else {
        "UNKNOWN: PowerShell host signature could not be established -> $path [$($sig.Status)]"
    }
}

function Get-NvidiaShadowPlayFtsAlerts {
    try {
        $gpus = @(
            CimCmdlets\Get-CimInstance Win32_VideoController `
                -OperationTimeoutSec 15 -ErrorAction Stop
        )

        if (-not $gpus.Count) {
            throw 'No GPU information returned.'
        }

        if (-not @(
            $gpus | Where-Object { $_.Name -match '(?i)nvidia' }
        ).Count) {
            return 'N/A: NVIDIA GPU not detected.'
        }

        $key = Open-LocalMachineRegistryKey $script:NvidiaShadowPlayFtsRegPath

        if (-not $key) {
            return 'INFO: NVIDIA ShadowPlay FTS key not present.'
        }

        try {
            $names = @($key.GetValueNames())

            if (-not $names.Count) {
                'INFO: NVIDIA ShadowPlay FTS key contains no values.'
            }

            foreach ($name in $names) {
                "INFO: ShadowPlay FTS $name = $($key.GetValue($name)); informational only."
            }
        } finally {
            $key.Dispose()
        }
    } catch {
        "UNKNOWN: NVIDIA state could not be read: $($_.Exception.Message)"
    }
}

function Test-KeywordTokenMatch {
    param(
        [string]$Text,
        [string]$Keyword
    )

    if (
        [string]::IsNullOrWhiteSpace($Text) -or
        [string]::IsNullOrWhiteSpace($Keyword)
    ) {
        return $false
    }

    return [regex]::IsMatch(
        $Text,
        '(?i)(?<![a-z0-9])' +
        [regex]::Escape($Keyword) +
        '(?![a-z0-9])'
    )
}

function Get-MatchedCheatKeyword {
    param(
        [string]$Text,
        [switch]$FolderName
    )

    foreach ($kw in $script:CheatKeywords) {
        if (Test-KeywordTokenMatch $Text $kw) {
            return $kw
        }
    }

    return $null
}

function Get-RoRNamedFileReview {
    param(
        [string]$Path,
        [string]$Context
    )

    $kw = Get-MatchedCheatKeyword -Text (
        [IO.Path]::GetFileNameWithoutExtension($Path)
    )

    if (-not $kw) {
        return
    }

    $sig = Get-RoRSignature $Path
    $signer = if ($sig.Publisher) { $sig.Publisher } else { 'unverified' }

    "REVIEW: $Context name matches '$kw'; this is not a cheat verdict -> $Path [signature=$($sig.Status); publisher=$signer]"
}

function Resolve-ExecutablePathFromCommandLine {
    param([string]$CommandLine)

    if ([string]::IsNullOrWhiteSpace($CommandLine)) {
        return $null
    }

    $text = [Environment]::ExpandEnvironmentVariables($CommandLine.Trim())

    if ($text -match '^"([^"]+)"') {
        return $matches[1]
    }

    if (Test-Path -LiteralPath $text -PathType Leaf -ErrorAction SilentlyContinue) {
        return $text
    }

    if ($text -match '^(.*?\.(?:exe|com|sys|dll))(?=\s|$)') {
        return $matches[1]
    }

    if ($text -match '^(\S+)') {
        return $matches[1]
    }

    return $null
}

function Get-RoRCommandReview {
    param(
        [string]$Command,
        [string]$Context
    )

    $exe = Resolve-ExecutablePathFromCommandLine $Command

    if (-not $exe) {
        return "UNKNOWN: Executable could not be resolved for $Context"
    }

    if (-not [IO.Path]::IsPathRooted($exe)) {
        $app = Microsoft.PowerShell.Core\Get-Command `
            -Name $exe -CommandType Application `
            -ErrorAction SilentlyContinue |
            Select-Object -First 1

        if ($app) {
            $exe = $app.Source
        } else {
            return "UNKNOWN: Executable path unavailable for $Context -> $exe"
        }
    }

    Get-RoRNamedFileReview -Path $exe -Context $Context
}

function Get-PersistenceAlerts {
    $review = New-Object 'System.Collections.Generic.List[string]'

    $keys = @(
        'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Run',
        'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce',
        'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Run',
        'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\RunOnce',
        'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Run',
        'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce'
    )

    foreach ($key in $keys) {
        try {
            if (-not (Test-Path -LiteralPath $key -ErrorAction Stop)) {
                continue
            }

            $item = Get-Item -LiteralPath $key -ErrorAction Stop

            try {
                foreach ($name in $item.GetValueNames()) {
                    $command = [string]$item.GetValue($name)
                    $context = "Autorun '$name' in $key"

                    foreach ($line in @(Get-RoRCommandReview $command $context)) {
                        [void]$review.Add($line)
                    }
                }
            } finally {
                $item.Dispose()
            }
        } catch {
            [void]$review.Add(
                "UNKNOWN: Autorun key unreadable: $key [$($_.Exception.Message)]"
            )
        }
    }

    $startupFolders = @(
        [Environment]::GetFolderPath('Startup'),
        [Environment]::GetFolderPath('CommonStartup')
    )

    foreach ($folder in $startupFolders) {
        try {
            if (
                -not $folder -or
                -not (Test-Path -LiteralPath $folder -ErrorAction Stop)
            ) {
                continue
            }

            foreach ($file in @(
                Get-ChildItem -LiteralPath $folder -File -ErrorAction Stop
            )) {
                $target = $file.FullName

                if ($file.Extension -ieq '.lnk') {
                    $shell = $null
                    $shortcut = $null

                    try {
                        $shell = New-Object -ComObject WScript.Shell
                        $shortcut = $shell.CreateShortcut($file.FullName)
                        $target = [Environment]::ExpandEnvironmentVariables(
                            $shortcut.TargetPath
                        )
                    } finally {
                        if ($shortcut) {
                            [void][Runtime.InteropServices.Marshal]::FinalReleaseComObject(
                                $shortcut
                            )
                        }

                        if ($shell) {
                            [void][Runtime.InteropServices.Marshal]::FinalReleaseComObject(
                                $shell
                            )
                        }
                    }
                }

                foreach ($line in @(
                    Get-RoRNamedFileReview `
                        $target "Startup target '$($file.Name)'"
                )) {
                    [void]$review.Add($line)
                }
            }
        } catch {
            [void]$review.Add(
                "UNKNOWN: Startup enumeration incomplete: $folder [$($_.Exception.Message)]"
            )
        }
    }

    try {
        $tasks = @(ScheduledTasks\Get-ScheduledTask -ErrorAction Stop)

        foreach ($task in $tasks) {
            if ($task.State -eq 'Disabled') {
                continue
            }

            foreach ($action in @($task.Actions)) {
                if (-not $action.Execute) {
                    continue
                }

                # Task names such as "Calibration Loader" are not indicators.
                $context = "Scheduled task '$($task.TaskPath)$($task.TaskName)'"

                foreach ($line in @(
                    Get-RoRCommandReview ([string]$action.Execute) $context
                )) {
                    [void]$review.Add($line)
                }

                $argKw = Get-MatchedCheatKeyword ([string]$action.Arguments)

                if ($argKw) {
                    [void]$review.Add(
                        "REVIEW: Task arguments contain '$argKw': $($task.TaskPath)$($task.TaskName); inspect the action before drawing conclusions."
                    )
                }
            }
        }

        [void]$review.Add(
            "INFO: Enumerated $($tasks.Count) tasks. Disabled tasks and non-executable actions are not classified by this heuristic."
        )
    } catch {
        [void]$review.Add(
            "UNKNOWN: Scheduled tasks could not be enumerated: $($_.Exception.Message)"
        )
    }

    if (-not @(
        $review | Where-Object { $_ -match '^(UNKNOWN|REVIEW|FAILURE):' }
    ).Count) {
        [void]$review.Add(
            'SUCCESS: No configured indicator matches in inspected persistence entries; coverage is heuristic.'
        )
    }

    return @($review.ToArray() | Select-Object -Unique)
}

function Convert-RoRDevicePath {
    param([string]$Path)

    if (-not ('RoR.DevicePaths' -as [type])) {
        Add-Type -Namespace RoR -Name DevicePaths -MemberDefinition @'
[DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
public static extern uint QueryDosDevice(
    string name,
    System.Text.StringBuilder target,
    int capacity
);
'@ -ErrorAction Stop
    }

    foreach ($drive in [Environment]::GetLogicalDrives()) {
        $buffer = New-Object Text.StringBuilder 32768

        if ([RoR.DevicePaths]::QueryDosDevice(
            $drive.TrimEnd('\'),
            $buffer,
            $buffer.Capacity
        ) -eq 0) {
            continue
        }

        $device = $buffer.ToString().Split([char]0)[0]

        if ($Path.StartsWith(
            $device + '\',
            [StringComparison]::OrdinalIgnoreCase
        )) {
            return $drive.TrimEnd('\') + $Path.Substring($device.Length)
        }
    }

    throw "Could not map device path to a mounted volume: $Path"
}

function Normalize-KernelDriverPath {
    param([string]$Path)

    if ([string]::IsNullOrWhiteSpace($Path)) {
        return $null
    }

    $p = [Environment]::ExpandEnvironmentVariables(
        $Path.Trim().Trim('"')
    ).Replace('/', '\')

    if (
        $p.StartsWith('\??\', [StringComparison]::OrdinalIgnoreCase) -or
        $p.StartsWith('\\?\', [StringComparison]::OrdinalIgnoreCase)
    ) {
        $p = $p.Substring(4)
    }

    if ($p.StartsWith('\SystemRoot\', [StringComparison]::OrdinalIgnoreCase)) {
        $p = $env:SystemRoot + $p.Substring(11)
    } elseif ($p.StartsWith('SystemRoot\', [StringComparison]::OrdinalIgnoreCase)) {
        $p = Join-Path $env:SystemRoot $p.Substring(11)
    } elseif ($p.StartsWith('System32\', [StringComparison]::OrdinalIgnoreCase)) {
        $p = Join-Path $env:SystemRoot $p
    }

    if ($p.StartsWith('\Device\', [StringComparison]::OrdinalIgnoreCase)) {
        $p = Convert-RoRDevicePath $p
    }

    return $p
}

function Resolve-KernelDriverImagePath {
    param(
        [string]$ServiceName,
        [string]$PathName
    )

    $candidates = New-Object 'System.Collections.Generic.List[string]'

    if ($PathName) {
        [void]$candidates.Add($PathName)
    }

    if ($ServiceName) {
        try {
            $key = Open-LocalMachineRegistryKey (
                'SYSTEM\CurrentControlSet\Services\' + $ServiceName
            )

            if ($key) {
                try {
                    $value = [string]$key.GetValue('ImagePath')

                    if ($value) {
                        [void]$candidates.Add($value)
                    }
                } finally {
                    $key.Dispose()
                }
            }
        } catch {
            Write-Verbose "Driver registry image path unavailable: $($_.Exception.Message)"
        }
    }

    foreach ($candidate in ($candidates | Select-Object -Unique)) {
        try {
            $path = Normalize-KernelDriverPath (
                Resolve-ExecutablePathFromCommandLine $candidate
            )

            if (
                $path -and
                (Test-Path -LiteralPath $path -PathType Leaf -ErrorAction Stop)
            ) {
                return (
                    Get-Item -LiteralPath $path -Force -ErrorAction Stop
                ).FullName
            }
        } catch {
            Write-Verbose "Driver path unavailable: $($_.Exception.Message)"
        }
    }

    return $null
}

function Get-SuspiciousDriverAlerts {
    try {
        $drivers = @(
            CimCmdlets\Get-CimInstance Win32_SystemDriver `
                -OperationTimeoutSec 15 -ErrorAction Stop |
                Where-Object { $_.State -eq 'Running' }
        )

        if (-not $drivers.Count) {
            return 'UNKNOWN: No running-driver inventory was returned.'
        }

        $valid = 0

        foreach ($drv in $drivers) {
            $path = Resolve-KernelDriverImagePath `
                -ServiceName $drv.Name -PathName $drv.PathName

            if (
                -not $path -or
                -not (Test-Path -LiteralPath $path -PathType Leaf `
                    -ErrorAction SilentlyContinue)
            ) {
                "UNKNOWN: Driver image unavailable for verification -> $($drv.Name) [$path]"
                continue
            }

            $sig = Get-RoRSignature $path

            switch ($sig.Status) {
                'Valid' {
                    $valid++
                }
                'HashMismatch' {
                    "FAILURE: Driver signature reports a hash mismatch -> $($drv.Name) [$path]"
                }
                'NotSigned' {
                    "REVIEW: No Authenticode/catalog signature was established for driver -> $($drv.Name) [$path]; this alone does not establish cheating."
                }
                default {
                    "UNKNOWN: Driver trust could not be established -> $($drv.Name) [$path] [$($sig.Status)]; no cheat verdict."
                }
            }

            if ($drv.Name -match '(?i)^(FACEIT|FACEIT_AC|vgk|RTCore64|RTCore32)$') {
                "INFO: Recognized driver name $($drv.Name); signature=$($sig.Status); publisher=$($sig.Publisher). The name is not an allowlist."
            }

            if ($drv.Name -match '(?i)^(RTCore64|RTCore32|Nal)$') {
                "INFO: Hardware-access driver $($drv.Name) is loaded. Assess its exact version against current vulnerable-driver policy; presence is not proof of exploitation."
            }
        }

        "INFO: Verified signatures for $valid of $($drivers.Count) running driver images. Signed drivers can still have vulnerabilities."
    } catch {
        "UNKNOWN: Driver inventory failed: $($_.Exception.Message)"
    }
}

function Test-MasqueradeProcessPath {
    param(
        [string]$ProcessName,
        [string]$ExecutablePath
    )

    if ([string]::IsNullOrWhiteSpace($ExecutablePath)) {
        return $null
    }

    $name = $ProcessName.ToLowerInvariant()

    if (-not $name.EndsWith('.exe')) {
        $name += '.exe'
    }

    if (-not $script:MasqueradeProcessPaths.ContainsKey($name)) {
        return $null
    }

    $path = Normalize-ProcessImagePath $ExecutablePath

    foreach ($suffix in $script:MasqueradeProcessPaths[$name]) {
        $relative = $suffix -replace '(?i)^\\windows\\', ''
        $expected = Normalize-ProcessImagePath (
            Join-Path $env:SystemRoot $relative
        )

        if ($path -ieq $expected) {
            return $null
        }
    }

    return "Process uses a Windows component name from an unexpected path: $ProcessName -> $ExecutablePath"
}

function Test-ClarityExpectedProcessPath {
    param(
        [string]$ProcessName,
        [string]$ExecutablePath
    )

    if ([string]::IsNullOrWhiteSpace($ExecutablePath)) {
        return $false
    }

    $name = $ProcessName.ToLowerInvariant()

    if (-not $name.EndsWith('.exe')) {
        $name += '.exe'
    }

    $path = Normalize-ProcessImagePath $ExecutablePath

    if ($name -eq 'svchost.exe') {
        return (
            $path -ieq (Join-Path $env:SystemRoot 'System32\svchost.exe') -or
            $path -ieq (Join-Path $env:SystemRoot 'SysWOW64\svchost.exe')
        )
    }

    if ($name -eq 'msmpeng.exe') {
        $expected = (
            Test-RoRPathWithin $path (
                Join-Path $env:ProgramData 'Microsoft\Windows Defender\Platform'
            )
        ) -or (
            $path -ieq (
                Join-Path $env:ProgramFiles 'Windows Defender\MsMpEng.exe'
            )
        )

        return (
            $expected -and
            [IO.Path]::GetFileName($path) -ieq 'MsMpEng.exe' -and
            (Test-SignedMicrosoftFile $path)
        )
    }

    if ($name -eq 'tiworker.exe') {
        return (
            (Test-RoRPathWithin $path (
                Join-Path $env:SystemRoot 'WinSxS'
            )) -and
            [IO.Path]::GetFileName($path) -ieq 'TiWorker.exe' -and
            (Test-SignedMicrosoftFile $path)
        )
    }

    return $false
}

function Get-ClarityDetectionAlerts {
    $path = Join-Path $env:SystemRoot `
        'System32\WindowsPowerShell\v1.0\Modules\ConfigDefender'

    try {
        if (Test-Path -LiteralPath $path -ErrorAction Stop) {
            $files = @(
                Get-ChildItem -LiteralPath $path -File -Recurse -ErrorAction Stop |
                    Where-Object {
                        $_.Extension -match '(?i)^\.(ps1|psm1|psd1|dll|cdxml|exe)$'
                    }
            )

            foreach ($file in $files) {
                $sig = Get-RoRSignature $file.FullName

                if ($sig.Status -eq 'HashMismatch') {
                    "FAILURE: ConfigDefender signature hash mismatch -> $($file.FullName)"
                } elseif (-not $sig.Microsoft) {
                    "REVIEW: ConfigDefender file publisher could not be established as Microsoft -> $($file.FullName) [$($sig.Status)]"
                }
            }
        } else {
            'INFO: ConfigDefender directory not present.'
        }

        $processes = @(
            CimCmdlets\Get-CimInstance Win32_Process `
                -OperationTimeoutSec 15 -ErrorAction Stop |
                Where-Object {
                    $_.Name -in @('svchost.exe', 'MsMpEng.exe', 'TiWorker.exe')
                }
        )

        foreach ($proc in $processes) {
            if (-not $proc.ExecutablePath) {
                continue
            }

            if (-not (
                Test-ClarityExpectedProcessPath $proc.Name $proc.ExecutablePath
            )) {
                "REVIEW: Verify Windows component path/signature -> $($proc.Name) [$($proc.ExecutablePath)]"
            }
        }

        if (Test-Path -LiteralPath `
            'HKLM:\SYSTEM\CurrentControlSet\Services\Nal' -ErrorAction Stop) {
            'REVIEW: NAL driver service is registered. Registration does not prove it is loaded or being exploited.'
        }

        'INFO: Component checks completed; no claim of kernel or in-memory integrity is made.'
    } catch {
        "UNKNOWN: Component verification incomplete: $($_.Exception.Message)"
    }
}

