function Update-ServiceChangeMonitor {
    param(
        [hashtable]$Previous,
        [hashtable]$Current,
        [hashtable]$Watched,
        [string]$LogFile
    )

    foreach ($name in $Current.Keys) {
        $svc = $Current[$name]
        if (-not $Previous.ContainsKey($name)) {
            if (-not $svc.Suspicious) { continue }
            $tags = @($svc.Reasons) -join ', '
            Write-MonitorAlert -Message "Service added [$tags]: $($svc.Name) -> $($svc.PathName)" -LogFile $LogFile -Color Yellow
            $Watched[$name] = $svc
            continue
        }

        $old = $Previous[$name]
        $changed = ($old.PathName -ne $svc.PathName) -or
                   ($old.StartMode -ne $svc.StartMode) -or
                   ($old.ServiceDll -ne $svc.ServiceDll)
        $becameRunning = ($old.State -ne 'Running' -and $svc.State -eq 'Running')
        if (($changed -or $becameRunning) -and $svc.Suspicious) {
            $tags = @($svc.Reasons) -join ', '
            Write-MonitorAlert -Message "Service changed [$tags]: $($svc.Name) -> $($svc.PathName)" -LogFile $LogFile -Color Yellow
            $Watched[$name] = $svc
        }

        if ($svc.Suspicious) {
            $Watched[$name] = $svc
        } elseif ($Watched.ContainsKey($name)) {
            $Watched.Remove($name) | Out-Null
        }
    }

    foreach ($name in $Previous.Keys) {
        if ($Current.ContainsKey($name)) { continue }
        if (-not $Watched.ContainsKey($name)) { continue }
        $old = $Previous[$name]
        Write-MonitorAlert -Message "Service removed: $($old.Name) -> $($old.PathName)" -LogFile $LogFile -Color Yellow
        $Watched.Remove($name) | Out-Null
    }
}

function Get-SuspiciousProcessHits {
    $hits = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    $messages = @()

    try {
        Get-CimInstance Win32_Process -ErrorAction Stop | ForEach-Object {
            $procName = $_.Name
            $procPath = $_.ExecutablePath
            $procId = $_.ProcessId

            $masquerade = Test-MasqueradeProcessPath -ProcessName $procName -ExecutablePath $procPath
            if ($masquerade) {
                $key = "masquerade|$procName|$procPath"
                if ($hits.Add($key)) { $messages += "FAILURE: Masquerade $procName (PID $procId)" }
            }

            $nameKw = Get-MatchedCheatKeyword -Text $procName
            if ($nameKw) {
                $key = "name|$procName|$nameKw"
                if ($hits.Add($key)) { $messages += "FAILURE: $procName (PID $procId) [$nameKw]" }
            }

            if ($procPath -and -not (Test-TrustedProcessPath -ExecutablePath $procPath)) {
                $pathKw = Get-MatchedCheatKeyword -Text $procPath
                if ($pathKw) {
                    $key = "path|$procPath|$pathKw|$procId"
                    if ($hits.Add($key)) { $messages += "FAILURE: $procPath (PID $procId) [$pathKw]" }
                }
            }
        }
    } catch {
        Get-Process -ErrorAction SilentlyContinue | ForEach-Object {
            $nameKw = Get-MatchedCheatKeyword -Text $_.Name
            if ($nameKw) {
                $key = "name|$($_.Name)|$nameKw"
                if ($hits.Add($key)) { $messages += "FAILURE: $($_.Name) (PID $($_.Id)) [$nameKw]" }
            }
        }
    }

    return $messages
}

