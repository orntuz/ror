function Get-ProcessSnapshot {
    $snapshot = @{}

    $processes = @(
        CimCmdlets\Get-CimInstance Win32_Process `
            -OperationTimeoutSec 15 -ErrorAction Stop
    )

    if (-not $processes.Count) {
        throw 'Empty process inventory; retaining previous sample.'
    }

    foreach ($p in $processes) {
        if ([int]$p.ProcessId -le 4) {
            continue
        }

        if (-not $p.CreationDate) {
            throw "Process creation time unavailable for PID $($p.ProcessId); identity cannot be tracked safely."
        }

        $created = $p.CreationDate.ToUniversalTime().ToString('o')
        $identity = '{0}|{1}' -f $p.ProcessId, $created

        $reasons = @(
            Get-ProcessSuspiciousReasons `
                ([string]$p.Name) ([string]$p.ExecutablePath)
        )

        $snapshot[$identity] = [pscustomobject]@{
            Id       = [int]$p.ProcessId
            Name     = [string]$p.Name
            Path     = [string]$p.ExecutablePath
            Created  = $created
            Reasons  = $reasons
            UserLand = Test-UserLandProcessPath ([string]$p.ExecutablePath)
        }
    }

    return $snapshot
}

function Get-SuspiciousProcessHits {
    try {
