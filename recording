function Get-TamperLogEvents {
    param(
        [datetime]$Since,
        [string]$LogFile
    )

    $until = [DateTime]::Now

    $filters = @(
        @{
            LogName      = 'Security'
            ProviderName = 'Microsoft-Windows-Eventlog'
            Id           = @(1102)
        },
        @{
            LogName      = 'System'
            ProviderName = 'Microsoft-Windows-Eventlog'
            Id           = @(104)
        },
        @{
            LogName      = 'Microsoft-Windows-Sysmon/Operational'
            ProviderName = 'Microsoft-Windows-Sysmon'
            Id           = @(12, 23, 26)
        }
    )

    foreach ($filter in $filters) {
        $key = $filter.LogName
        $start = $Since

        if ($script:RoREventWatermarks.ContainsKey($key)) {
            $start = $script:RoREventWatermarks[$key].AddSeconds(-2)
        }

        $filter.StartTime = $start
        $filter.EndTime = $until

        try {
            $events = @(
                Get-WinEvent -FilterHashtable $filter -ErrorAction Stop
            )
        } catch {
            if ($_.FullyQualifiedErrorId -like 'NoMatchingEventsFound*') {
                $events = @()
            } else {
                "UNKNOWN: Event channel $key unavailable: $($_.Exception.Message)"
                continue
            }
        }

        foreach ($ev in $events) {
            $id = "$key|$($ev.RecordId)|$($ev.TimeCreated.ToUniversalTime().Ticks)"

            if ($script:RoREventSeen.ContainsKey($id)) {
                continue
            }

            $script:RoREventSeen[$id] = $ev.TimeCreated

            if ($ev.Id -in @(1102, 104)) {
                "REVIEW: Event log cleared; provider=$($ev.ProviderName), channel=$key, event=$($ev.Id), at=$($ev.TimeCreated.ToUniversalTime().ToString('o'))"
                continue
            }

            [xml]$xml = $ev.ToXml()
            $data = @{}

            foreach ($field in $xml.Event.EventData.Data) {
                $data[[string]$field.Name] = [string]$field.'#text'
            }

            if (
                $ev.Id -eq 12 -and
                $data.EventType -match '^Delete' -and
                $data.TargetObject -match '(?i)\\Services\\(?:bam|dam)\\'
            ) {
                "REVIEW: BAM/DAM registry object deleted: $($data.TargetObject) [image=$($data.Image)]"
            } elseif (
                $ev.Id -in @(23, 26) -and
                $data.TargetFilename -match '(?i)\\Prefetch\\'
            ) {
                "INFO: Prefetch file deleted: $($data.TargetFilename) [image=$($data.Image); event=$($ev.Id)]. Deletion alone does not establish tampering."
            }
        }

        $script:RoREventWatermarks[$key] = $until
    }

    foreach ($id in @($script:RoREventSeen.Keys)) {
        if ($script:RoREventSeen[$id] -lt $until.AddMinutes(-5)) {
            $script:RoREventSeen.Remove($id)
        }
    }
}

