function Test-UserWritablePersistencePath {
    param([string]$Path)

    if ([string]::IsNullOrWhiteSpace($Path)) { return $false }
    $p = [Environment]::ExpandEnvironmentVariables($Path).ToLower().Replace('/', '\')

    foreach ($marker in @(
        '\users\',
        '\windows\temp\',
        '\temp\'
    )) {
        if ($p -like "*$marker*") { return $true }
    }

    return $false
}

function Get-ServiceHostedDllPath {
    param([string]$ServiceName)

    if ([string]::IsNullOrWhiteSpace($ServiceName)) { return $null }
    try {
        return [string](Get-ItemPropertyValue -Path "HKLM:\SYSTEM\CurrentControlSet\Services\$ServiceName\Parameters" -Name 'ServiceDll' -ErrorAction Stop)
    } catch {
        return $null
    }
}

function Test-MasqueradeServicePath {
    param(
        [string]$ServiceName,
        [string]$DisplayName,
        [string]$PathName,
        [string]$StartMode,
        [string]$State
    )

    if ([string]::IsNullOrWhiteSpace($ServiceName) -or [string]::IsNullOrWhiteSpace($PathName)) { return $null }

    $resolved = Resolve-ExecutablePathFromCommandLine -CommandLine $PathName
    $normalized = Normalize-KernelDriverPath -Path $resolved
    $serviceLower = $ServiceName.ToLower()

    if ($script:CriticalWindowsServiceImagePaths.ContainsKey($serviceLower) -and $normalized) {
        $valid = Test-ExactCanonicalWindowsPath -CandidatePath $normalized -AllowedPaths $script:CriticalWindowsServiceImagePaths[$serviceLower]
        if (-not $valid) {
            return "Critical Windows service '$ServiceName' points to a non-standard image: $normalized"
        }
    }

    if ($normalized) {
        $processMasquerade = Test-MasqueradeProcessPath -ProcessName (Split-Path -Leaf $normalized) -ExecutablePath $normalized
        if ($processMasquerade) {
            return "Service '$ServiceName' uses a masqueraded Windows executable: $normalized"
        }
    }

    $activeOrAuto = ($State -eq 'Running') -or ($StartMode -match '(?i)^(Auto|Automatic|Boot|System)$')
    if ($activeOrAuto -and (Test-UserWritablePersistencePath -Path $normalized)) {
        return "Service '$ServiceName' uses a user-writable persistence path: $normalized"
    }

    if ($activeOrAuto -and $DisplayName -match '(?i)^(Microsoft|Windows|Windows Defender|Microsoft Defender|Security|System|Windows Update|Update)\b' -and
        (Test-UserWritablePersistencePath -Path $normalized)) {
        return "Windows-like service '$DisplayName' runs from a user-writable path: $normalized"
    }

    $isSvchostHosted = $normalized -and ((Split-Path -Leaf $normalized) -ieq 'svchost.exe')
    $serviceDllRaw = if ($isSvchostHosted) { Get-ServiceHostedDllPath -ServiceName $ServiceName } else { $null }
    if ($serviceDllRaw) {
        $serviceDll = Normalize-KernelDriverPath -Path $serviceDllRaw
        $dllKw = Get-MatchedCheatKeyword -Text $serviceDll
        if ($dllKw) {
            return "Service '$ServiceName' hosted DLL matches suspicious keyword [$dllKw]: $serviceDll"
        }
        if ($activeOrAuto -and (Test-UserWritablePersistencePath -Path $serviceDll)) {
            return "Service '$ServiceName' uses a user-writable ServiceDll path: $serviceDll"
        }
    }

    return $null
}

function Get-ServiceSuspiciousReasons {
    param($Service)

    $reasons = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    $masquerade = Test-MasqueradeServicePath -ServiceName ([string]$Service.Name) -DisplayName ([string]$Service.DisplayName) -PathName ([string]$Service.PathName) -StartMode ([string]$Service.StartMode) -State ([string]$Service.State)
    if ($masquerade) { [void]$reasons.Add('masquerade') }

    $path = Resolve-ExecutablePathFromCommandLine -CommandLine ([string]$Service.PathName)
    if ($path) {
        $kw = Get-MatchedCheatKeyword -Text ([string]$Service.Name)
        if (-not $kw) { $kw = Get-MatchedCheatKeyword -Text ([string]$Service.DisplayName) }
        if (-not $kw) { $kw = Get-MatchedCheatKeyword -Text $path }
        if ($kw) { [void]$reasons.Add($kw) }

        if (([string]$Service.State -eq 'Running' -or [string]$Service.StartMode -match '(?i)^(Auto|Automatic|Boot|System)$') -and
            (Test-UserWritablePersistencePath -Path $path)) {
            [void]$reasons.Add('user-writable service path')
        }
    }

    return @($reasons)
}

function Get-SuspiciousServiceAlerts {
    $alerts = @()
    try {
        $services = @(Get-CimInstance -ClassName Win32_Service -ErrorAction Stop)
    } catch {
        return @('WARNING: Could not enumerate Windows services.')
    }

    foreach ($service in $services) {
        $reasons = @(Get-ServiceSuspiciousReasons -Service $service)
        if ($reasons.Count -eq 0) { continue }

        $path = Resolve-ExecutablePathFromCommandLine -CommandLine ([string]$service.PathName)
        $serviceDll = Get-ServiceHostedDllPath -ServiceName ([string]$service.Name)
        $detail = if ($serviceDll) { "$path | ServiceDll -> $serviceDll" } else { $path }
        $tags = $reasons -join ', '
        $severity = if ($reasons -contains 'masquerade' -or $reasons -contains 'user-writable service path') { 'FAILURE' } else { 'WARNING' }
        $alerts += "${severity}: Suspicious service [$tags] $($service.Name) -> $detail"
    }

    if ($alerts.Count -eq 0) { $alerts += 'SUCCESS: No suspicious service masquerade/persistence paths detected.' }
    return @($alerts | Select-Object -Unique)
}

