function Get-KnownKernelDriverProfile {
    param(
        [string]$ServiceName,
        [string]$DisplayName,
        [string]$ResolvedPath,
        [string]$SignerSubject
    )

    $identity = "$ServiceName $DisplayName $ResolvedPath"
    foreach ($profile in $script:KnownKernelDriverProfiles) {
        $identityMatch = $false
        if ($profile.NamePattern -and $identity -match $profile.NamePattern) { $identityMatch = $true }
        if ($profile.FilePattern -and $ResolvedPath -and $ResolvedPath -match $profile.FilePattern) { $identityMatch = $true }
        if (-not $identityMatch -and $profile.PathPattern -and $ResolvedPath -and $ResolvedPath -match $profile.PathPattern) {
            $identityMatch = $true
        }
        if (-not $identityMatch) { continue }

        $publisherMatch = $false
        if ($profile.PublisherPattern -and $SignerSubject -and $SignerSubject -match $profile.PublisherPattern) {
            $publisherMatch = $true
        }

        return @{
            Label          = $profile.Label
            PublisherMatch = $publisherMatch
        }
    }
    return $null
}

function Get-SuspiciousDriverAlerts {
    $alerts = @()

    try {
        $drivers = @(Get-CimInstance -ClassName Win32_SystemDriver -ErrorAction Stop |
            Where-Object { $_.State -eq 'Running' })
    } catch {
        $alerts += 'WARNING: Could not enumerate kernel drivers.'
        return $alerts
    }

    foreach ($drv in $drivers) {
        $rawPath = [string]$drv.PathName
        $resolvedPath = Resolve-KernelDriverImagePath -ServiceName ([string]$drv.Name) -PathName $rawPath

        $kw = Get-MatchedCheatKeyword -Text $drv.Name
        if (-not $kw) { $kw = Get-MatchedCheatKeyword -Text $drv.DisplayName }
        if (-not $kw) { $kw = Get-MatchedCheatKeyword -Text $resolvedPath }

        if ($kw) {
            $alerts += "FAILURE: Suspicious kernel driver [$kw] $($drv.Name) -> $resolvedPath"
            continue
        }

        if ([string]::IsNullOrWhiteSpace($resolvedPath)) {
            $alerts += "WARNING: Could not resolve kernel driver image path: $($drv.Name)"
            continue
        }

        $pathExists = Test-Path -LiteralPath $resolvedPath -PathType Leaf -ErrorAction SilentlyContinue
        $signatureStatus = 'UnknownError'
        $signerSubject = ''
        $sig = $null

        if ($pathExists) {
            try {
                $sig = Microsoft.PowerShell.Security\Get-AuthenticodeSignature -LiteralPath $resolvedPath -ErrorAction Stop
                $signatureStatus = [string]$sig.Status
                if ($sig.SignerCertificate) { $signerSubject = [string]$sig.SignerCertificate.Subject }
            } catch {
                $signatureStatus = 'UnknownError'
            }
        } else {
            $signatureStatus = 'FileNotFound'
        }

        $known = Get-KnownKernelDriverProfile -ServiceName ([string]$drv.Name) -DisplayName ([string]$drv.DisplayName) -ResolvedPath $resolvedPath -SignerSubject $signerSubject
        if ($known) {
            switch ($signatureStatus) {
                'Valid' {
                    $alerts += "INFO: Recognized $($known.Label) driver -> $($drv.Name)"
                }
                'HashMismatch' {
                    $alerts += "FAILURE: $($known.Label) driver signature hash mismatch -> $($drv.Name) -> $resolvedPath"
                }
                'NotSigned' {
                    $alerts += "WARNING: Recognized $($known.Label) driver is unsigned -> $($drv.Name) -> $resolvedPath"
                }
                'FileNotFound' {
                    $alerts += "WARNING: Recognized $($known.Label) driver image is missing/unreadable -> $($drv.Name) -> $resolvedPath"
                }
                default {
                    $alerts += "INFO: Recognized $($known.Label) driver; signature verification was inconclusive -> $($drv.Name) [$signatureStatus]"
                }
            }
            continue
        }

        switch ($signatureStatus) {
            'Valid' {
                # A validly signed third-party kernel driver is not a cheat finding by itself.
            }
            'NotSigned' {
                $alerts += "WARNING: Unsigned kernel driver: $($drv.Name) -> $resolvedPath"
            }
            'HashMismatch' {
                $alerts += "FAILURE: Kernel driver signature hash mismatch: $($drv.Name) -> $resolvedPath"
            }
            'NotTrusted' {
                if ($signerSubject) {
                    $alerts += "INFO: Kernel driver has a signature, but Windows could not establish trust: $($drv.Name) -> $resolvedPath [$signerSubject]"
                } else {
                    $alerts += "INFO: Kernel driver signature trust could not be established: $($drv.Name) -> $resolvedPath"
                }
            }
            'FileNotFound' {
                $alerts += "WARNING: Kernel driver image not found/readable: $($drv.Name) -> $resolvedPath"
            }
            'UnknownError' {
                $alerts += "INFO: Kernel driver signature verification was inconclusive: $($drv.Name) -> $resolvedPath"
            }
            default {
                $alerts += "INFO: Kernel driver signature status is ${signatureStatus}: $($drv.Name) -> $resolvedPath"
            }
        }
    }

    if ($alerts.Count -eq 0) { $alerts += 'SUCCESS: No suspicious kernel drivers detected.' }
    return @($alerts | Select-Object -Unique)
}


function Resolve-CanonicalWindowsExpectedPath {
    param([string]$ExpectedPath)

    if ([string]::IsNullOrWhiteSpace($ExpectedPath)) { return $null }

    $p = [Environment]::ExpandEnvironmentVariables($ExpectedPath).Trim().Trim('"').Replace('/', '\')
    if ($p -match '(?i)^\\windows\\') {
        $p = $env:SystemRoot + $p.Substring(8)
    } elseif ($p -match '(?i)^windows\\') {
        $p = Join-Path $env:SystemDrive $p
    }

    try { $p = [System.IO.Path]::GetFullPath($p) } catch {}
    return $p.TrimEnd('\')
}

function Test-ExactCanonicalWindowsPath {
    param(
        [string]$CandidatePath,
        [string[]]$AllowedPaths
    )

    if ([string]::IsNullOrWhiteSpace($CandidatePath)) { return $false }
    $candidate = [Environment]::ExpandEnvironmentVariables($CandidatePath).Trim().Trim('"').Replace('/', '\')
    try { $candidate = [System.IO.Path]::GetFullPath($candidate) } catch {}
    foreach ($allowed in $AllowedPaths) {
        $expected = Resolve-CanonicalWindowsExpectedPath -ExpectedPath $allowed
        if ($expected -and [StringComparer]::OrdinalIgnoreCase.Equals($candidate.TrimEnd('\'), $expected)) {
            return $true
        }
    }
    return $false
}

function Test-MasqueradeProcessPath {
    param(
        [string]$ProcessName,
        [string]$ExecutablePath
    )

    if ([string]::IsNullOrWhiteSpace($ExecutablePath)) { return $null }
    $nameLower = $ProcessName.ToLower()
    if (-not $script:MasqueradeProcessPaths.ContainsKey($nameLower)) { return $null }

    if (Test-ExactCanonicalWindowsPath -CandidatePath $ExecutablePath -AllowedPaths $script:MasqueradeProcessPaths[$nameLower]) {
        return $null
    }

    return "Windows process '$ProcessName' running from non-standard path: $ExecutablePath"
}


