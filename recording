function Get-AllowedDefenderThreats {
    $list = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)

    foreach ($relPath in @(
        'SOFTWARE\Microsoft\Windows Defender\Exclusions\Threats',
        'SOFTWARE\Policies\Microsoft\Windows Defender\Exclusions\Threats'
    )) {
        try {
            $key = Open-LocalMachineRegistryKey -SubKeyPath $relPath
            if (-not $key) { continue }
            foreach ($name in $key.GetValueNames()) {
                if ($name) { [void]$list.Add("$relPath -> $name") }
            }
            foreach ($subName in $key.GetSubKeyNames()) {
                [void]$list.Add("$relPath\$subName")
            }
            $key.Close()
        } catch {}
    }

    foreach ($root in $script:DefenderThreatsRegRoots) {
        try {
            $key = Open-LocalMachineRegistryKey -SubKeyPath $root
            if (-not $key) { continue }
            foreach ($subName in $key.GetSubKeyNames()) {
                if ($script:DefenderThreatsSystemSubkeys -contains $subName) { continue }
                if ($subName -match '(?i)^\{?[0-9A-F-]{36}\}?$|^\d+$') {
                    [void]$list.Add("$root\$subName")
                }
            }
            $key.Close()
        } catch {}
    }

    return @($list)
}

function Get-ClarityDefenderModulePath {
    return (Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\Modules\ConfigDefender')
}

function Test-ClarityConfigDefender {
    param(
        [switch]$FullScan
    )

    $alerts = @()
    $cdPath = Get-ClarityDefenderModulePath
    if (-not (Test-Path -LiteralPath $cdPath -PathType Container -ErrorAction SilentlyContinue)) {
        $alerts += 'INFO: ConfigDefender module directory not present; Clarity ConfigDefender replacement check not applicable.'
        return $alerts
    }

    $tampered = $false
    $cdFiles = @(Get-ChildItem -LiteralPath $cdPath -Recurse -Force -File -ErrorAction SilentlyContinue)

    if ($FullScan) {
        foreach ($file in $cdFiles) {
            try {
                $sig = Microsoft.PowerShell.Security\Get-AuthenticodeSignature -FilePath $file.FullName -ErrorAction Stop
                $isMicrosoft = $false
                if ($sig.SignerCertificate) {
                    $isMicrosoft = ($sig.SignerCertificate.Subject -match '(?i)Microsoft')
                }

                if ($sig.Status -ne 'Valid' -or ($sig.SignerCertificate -and -not $isMicrosoft)) {
                    $alerts += "FAILURE: Unsigned/non-Microsoft file in ConfigDefender: '$($file.FullName)' [$($sig.Status)]"
                    $tampered = $true
                }
            } catch {
                $alerts += "WARNING: Could not verify ConfigDefender file: '$($file.FullName)'"
            }
        }

        $psm1File = Join-Path $cdPath 'ConfigDefender.psm1'
        if (Test-Path -LiteralPath $psm1File -PathType Leaf -ErrorAction SilentlyContinue) {
            try {
                $psm1Content = Get-Content -LiteralPath $psm1File -Raw -ErrorAction Stop
                if ($psm1Content -match '(?i)Spoofed ConfigDefender|No-op|Silently fail') {
                    $alerts += 'FAILURE: ConfigDefender.psm1 contains spoofed/fake module markers.'
                    $tampered = $true
                }
            } catch {
                $alerts += "WARNING: Could not inspect ConfigDefender.psm1: '$psm1File'"
            }
        }
    }

    $backupNames = @('ConfigDefender_exe_backup', 'Defender_exe_backup', 'ConfigDefender_exe_b')
    foreach ($bname in $backupNames) {
        try {
            $found = @(Get-ChildItem -LiteralPath $cdPath -Filter "*$bname*" -Recurse -Force -ErrorAction SilentlyContinue)
            foreach ($item in $found) {
                $alerts += "FAILURE: ConfigDefender backup artifact found: '$($item.FullName)'"
                $tampered = $true
            }
        } catch {}
    }

    $parentDir = Split-Path -Path $cdPath -Parent
    foreach ($bname in $backupNames) {
        try {
            $found = @(Get-ChildItem -LiteralPath $parentDir -Filter "*$bname*" -Force -ErrorAction SilentlyContinue)
            foreach ($item in $found) {
                $alerts += "FAILURE: ConfigDefender backup artifact found in module parent: '$($item.FullName)'"
                $tampered = $true
            }
        } catch {}
    }

    if (-not $tampered -and $alerts.Count -eq 0) {
        $alerts += 'SUCCESS: ConfigDefender module is intact.'
    }

    return @($alerts | Select-Object -Unique)
}

function Initialize-ClarityNalApi {
    if ('RoR.ClarityNal' -as [type]) { return $true }
    try {
        Add-Type -Namespace RoR -Name ClarityNal -MemberDefinition @'
[DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
private static extern IntPtr CreateFileW(
    string name,
    uint access,
    uint share,
    IntPtr security,
    uint creationDisposition,
    uint flags,
    IntPtr template);
