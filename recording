        'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Run',
        'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce',
        'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnceEx',
        'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\RunServices',
        'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\RunServicesOnce'
    )

    foreach ($keyPath in $runKeys) {
        try {
            $props = Get-ItemProperty -Path $keyPath -ErrorAction Stop
            foreach ($prop in $props.PSObject.Properties) {
                if ($prop.Name -match '^PS(Path|ParentPath|ChildName|Provider)$') { continue }
                $value = [string]$prop.Value
                $kw = Get-MatchedCheatKeyword -Text $value
                if (-not $kw) { $kw = Get-MatchedCheatKeyword -Text $prop.Name }
                if ($kw) {
                    $alerts += "FAILURE: Autorun entry [$kw] '$($prop.Name)' in $keyPath -> $value"
                }
            }
        } catch {}
    }

    foreach ($keyPath in @(
        'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon',
        'HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon'
    )) {
        try {
            $props = Get-ItemProperty -Path $keyPath -ErrorAction Stop
            foreach ($name in @('Shell', 'Userinit', 'UIHost')) {
                try {
                    $value = [string](Get-ItemPropertyValue -Path $keyPath -Name $name -ErrorAction Stop)
                    $kw = Get-MatchedCheatKeyword -Text $value
                    if ($kw) {
                        $alerts += "FAILURE: Winlogon autorun [$kw] $name in $keyPath -> $value"
                    }
                } catch {}
            }
        } catch {}
    }

    $startupFolders = @()
    try { $startupFolders += [Environment]::GetFolderPath('Startup') } catch {}
    try { $startupFolders += [Environment]::GetFolderPath('CommonStartup') } catch {}

    foreach ($folder in ($startupFolders | Select-Object -Unique)) {
        if ([string]::IsNullOrWhiteSpace($folder) -or -not (Test-Path -LiteralPath $folder)) { continue }
        Get-ChildItem -LiteralPath $folder -File -ErrorAction SilentlyContinue | ForEach-Object {
            $kw = Get-MatchedCheatKeyword -Text $_.Name
            if ($kw) { $alerts += "FAILURE: Startup item [$kw] -> $($_.FullName)" }
        }
    }

    try {
        Get-ScheduledTask -ErrorAction Stop | Where-Object { $_.State -ne 'Disabled' } | ForEach-Object {
            $task = $_
            $actions = @($task.Actions | ForEach-Object { "$($_.Execute) $($_.Arguments)" })
            $combined = "$($task.TaskName) $($actions -join ' ')"
            $kw = Get-MatchedCheatKeyword -Text $combined
            if ($kw) {
                $alerts += "FAILURE: Scheduled task [$kw] '$($task.TaskName)' -> $($actions -join '; ')"
            }
        }
    } catch {
        $alerts += 'WARNING: Could not enumerate scheduled tasks.'
    }

    if ($alerts.Count -eq 0) { $alerts += 'SUCCESS: No suspicious native persistence entries found.' }
    return @($alerts | Select-Object -Unique)
}

function Get-AutorunObjectField {
    param(
        [Parameter(Mandatory = $true)]$Object,
        [Parameter(Mandatory = $true)][string[]]$Names
    )

    foreach ($name in $Names) {
        $prop = $Object.PSObject.Properties | Where-Object { $_.Name -ieq $name } | Select-Object -First 1
        if ($prop) { return [string]$prop.Value }
    }
    return ''
}

function Get-AutorunsAlerts {
    $alerts = @()
    $destDir = Join-Path $env:TEMP 'RoRAutoruns'
    $zipPath = Join-Path $env:TEMP 'ror_autoruns.zip'
    $csvPath = Join-Path $env:TEMP 'ror_autoruns.csv'
    $errPath = Join-Path $env:TEMP 'ror_autoruns.err.txt'

    $exe = Resolve-ToolExecutable -DestDir $destDir -ExeName 'Autorunsc64.exe' -FallbackNames @('Autorunsc.exe')
    if (-not $exe) {
        if (Invoke-ToolDownload -Url 'https://download.sysinternals.com/files/Autoruns.zip' -ZipPath $zipPath -DestDir $destDir) {
            $exe = Resolve-ToolExecutable -DestDir $destDir -ExeName 'Autorunsc64.exe' -FallbackNames @('Autorunsc.exe')
        }
    }

    if (-not $exe) {
        return @('WARNING: Microsoft Autorunsc unavailable; native persistence checks were still performed.')
    }

    if (-not (Test-SignedMicrosoftFile -Path $exe)) {
        return @('WARNING: Microsoft Autorunsc rejected because its Microsoft Authenticode signature could not be validated.')
    }

    foreach ($path in @($csvPath, $errPath)) {
        try { if (Test-Path -LiteralPath $path) { Remove-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue } } catch {}
    }

    try {
        $args = @('-accepteula', '-nobanner', '-a', '*', '-c', '-s', '-h', '*')
        $proc = Start-Process -FilePath $exe -ArgumentList $args -RedirectStandardOutput $csvPath -RedirectStandardError $errPath -WindowStyle Hidden -PassThru -Wait -ErrorAction Stop

        if (-not (Test-Path -LiteralPath $csvPath)) {
            $err = ''
            try { $err = (Get-Content -LiteralPath $errPath -Raw -ErrorAction SilentlyContinue).Trim() } catch {}
            if ($err) {
                return @("WARNING: Autorunsc did not produce CSV output (exit code $($proc.ExitCode)): $err")
            }
            return @("WARNING: Autorunsc did not produce CSV output (exit code $($proc.ExitCode)).")
        }

        $rows = @(Import-Csv -LiteralPath $csvPath -ErrorAction Stop)
        $failures = @()
        $warnings = @()
        $unsignedCount = 0
        $keywordCount = 0

        foreach ($row in $rows) {
            $location = Get-AutorunObjectField -Object $row -Names @('Entry Location', 'EntryLocation')
            $entry     = Get-AutorunObjectField -Object $row -Names @('Entry')
            $category  = Get-AutorunObjectField -Object $row -Names @('Category')
            $enabled   = Get-AutorunObjectField -Object $row -Names @('Enabled')
            $publisher = Get-AutorunObjectField -Object $row -Names @('Publisher', 'Company')
            $signer    = Get-AutorunObjectField -Object $row -Names @('Signer')
            $imagePath = Get-AutorunObjectField -Object $row -Names @('Image Path', 'ImagePath')
            $launch    = Get-AutorunObjectField -Object $row -Names @('Launch String', 'LaunchString')
            $description = Get-AutorunObjectField -Object $row -Names @('Description')

            if ($enabled -and $enabled -notmatch '(?i)^enabled$') { continue }

            $combined = "$location $entry $category $publisher $signer $imagePath $launch $description"
            $kw = Get-MatchedCheatKeyword -Text $combined
            if ($kw) {
                $keywordCount++
                $failures += "FAILURE: Autorunsc keyword [$kw] $category '$entry' -> $launch"
                continue
            }

            $isMissing = $imagePath -match '(?i)^(File not found|\*\*\* not found|Not found)'
            if ($isMissing) {
                $warnings += "WARNING: Autorun entry image missing -> $category '$entry' -> $imagePath"
                continue
            }

            $isUnsigned = [string]::IsNullOrWhiteSpace($signer) -or $signer -match '(?i)Not verified|Not Signed|Unsigned'
            if (-not $isUnsigned) { continue }

            $unsignedCount++
            $highRiskCategory = $category -match '(?i)Services|Drivers|Boot Execute|Winlogon|Appinit|Image Hijacks|WMI|LSA|Printer|Known DLLs'
            $userWritable = $imagePath -match '(?i)\\Users\\|\\Windows\\Temp\\|\\Temp\\'
            if ($highRiskCategory -or $userWritable) {
                $warnings += "WARNING: Unsigned high-risk autorun -> $category '$entry' | $imagePath"
            }
        }

        if ($failures.Count -gt 0) { $alerts += $failures | Select-Object -Unique }
        if ($warnings.Count -gt 0) { $alerts += $warnings | Select-Object -Unique }

        if ($alerts.Count -eq 0) {
            $alerts += "SUCCESS: Autorunsc scan completed ($($rows.Count) entries; no suspicious keyword or high-risk unsigned entries)."
        } else {
            $alerts = @("INFO: Autorunsc scanned $($rows.Count) entries; keyword hits=$keywordCount, unsigned/high-risk findings=$unsignedCount") + $alerts
        }
    } catch {
        $alerts += "WARNING: Autorunsc scan failed -> $($_.Exception.Message)"
    } finally {
        foreach ($path in @($csvPath, $errPath)) {
            try { if (Test-Path -LiteralPath $path) { Remove-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue } } catch {}
        }
    }

    return @($alerts | Select-Object -Unique)
}


function Resolve-ExecutablePathFromCommandLine {
    param([string]$CommandLine)

    if ([string]::IsNullOrWhiteSpace($CommandLine)) { return $null }

    $text = $CommandLine.Trim()

    $match = [regex]::Match($text, '^\s*"([^"]+)"')
    if ($match.Success) { return $match.Groups[1].Value }

    $tokens = @($text -split '\s+')
    $maxTokens = [Math]::Min($tokens.Count, 12)
    for ($i = $maxTokens; $i -ge 1; $i--) {
        $candidate = ($tokens[0..($i - 1)] -join ' ').Trim()
        $candidateExpanded = [Environment]::ExpandEnvironmentVariables($candidate).Trim('"')
        try {
            if (Test-Path -LiteralPath $candidateExpanded -PathType Leaf -ErrorAction Stop) {
                return $candidate.Trim('"')
            }
        } catch {}
    }

    $match = [regex]::Match($text, '^\s*(?<path>(?:[A-Za-z]:|\\SystemRoot|SystemRoot|\\\?\?|\\\\\?\?)[^\"]+?\.(?:exe|sys|dll))(?=\s|$)', [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)
    if ($match.Success) { return $match.Groups['path'].Value }

    return $tokens[0]
}


function Normalize-KernelDriverPath {
    param([string]$Path)

    if ([string]::IsNullOrWhiteSpace($Path)) { return $null }

    $path = [Environment]::ExpandEnvironmentVariables($Path.Trim().Trim('"'))

    if ($path.StartsWith('\??\', [StringComparison]::OrdinalIgnoreCase)) {
        $path = $path.Substring(4)
    } elseif ($path.StartsWith('\\?\', [StringComparison]::OrdinalIgnoreCase)) {
        $path = $path.Substring(4)
    }

    if ($path.StartsWith('\SystemRoot\', [StringComparison]::OrdinalIgnoreCase)) {
        $path = $env:SystemRoot + $path.Substring(11)
    } elseif ($path.StartsWith('SystemRoot\', [StringComparison]::OrdinalIgnoreCase)) {
        $path = Join-Path $env:SystemRoot $path.Substring(11)
    } elseif ($path.StartsWith('System32\', [StringComparison]::OrdinalIgnoreCase)) {
        $path = Join-Path $env:SystemRoot $path
    }

    return $path.Trim('"')
}

function Resolve-KernelDriverImagePath {
    param(
        [string]$ServiceName,
        [string]$PathName
    )

    $candidates = New-Object 'System.Collections.Generic.List[string]'

    $direct = Resolve-ExecutablePathFromCommandLine -CommandLine $PathName
    if ($direct) { [void]$candidates.Add($direct) }

    if ($ServiceName) {
        try {
            $regPath = "HKLM:\SYSTEM\CurrentControlSet\Services\$ServiceName"
            $imagePath = Get-ItemPropertyValue -Path $regPath -Name ImagePath -ErrorAction Stop
            $fromRegistry = Resolve-ExecutablePathFromCommandLine -CommandLine ([string]$imagePath)
            if ($fromRegistry) { [void]$candidates.Add($fromRegistry) }
        } catch {}
    }

    foreach ($candidate in ($candidates | Select-Object -Unique)) {
        $normalized = Normalize-KernelDriverPath -Path $candidate
        if ([string]::IsNullOrWhiteSpace($normalized)) { continue }

        try {
            if (Test-Path -LiteralPath $normalized -PathType Leaf -ErrorAction Stop) {
                return (Get-Item -LiteralPath $normalized -Force -ErrorAction Stop).FullName
            }
        } catch {}
    }

    foreach ($candidate in ($candidates | Select-Object -Unique)) {
        $normalized = Normalize-KernelDriverPath -Path $candidate
        if ($normalized) { return $normalized }
    }

    return $null
}

