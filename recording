function Test-TamperEventLogAvailable {
    param([string]$LogName)

    if ($script:TamperLogAvailability.ContainsKey($LogName)) {
        return [bool]$script:TamperLogAvailability[$LogName]
    }

    try {
        $log = Microsoft.PowerShell.Diagnostics\Get-WinEvent -ListLog $LogName -ErrorAction Stop
        $exists = $null -ne $log
    } catch {
        $exists = $false
    }

    $script:TamperLogAvailability[$LogName] = $exists
    return $exists
}

function Get-TamperLogEvents {
    param(
        [datetime]$Since,
        [string]$LogFile
    )

    $events = @()

    $filters = @(
        @{ LogName = 'Security'; Id = 1102 },
        @{ LogName = 'System'; Id = 104 }
    )

    if (Test-TamperEventLogAvailable -LogName 'Microsoft-Windows-Eventlog/Operational') {
        $filters += @{ LogName = 'Microsoft-Windows-Eventlog/Operational'; Id = 104 }
    }

    foreach ($filter in $filters) {
        if (-not (Test-TamperEventLogAvailable -LogName ([string]$filter.LogName))) { continue }
        try {
            $filter.StartTime = $Since
            Microsoft.PowerShell.Diagnostics\Get-WinEvent -FilterHashtable $filter -ErrorAction Stop |
                ForEach-Object { $events += $_ }
        } catch {
            if ($_.Exception.Message -notmatch '(?i)no events were found') {
                $warnKey = "winevent|$($filter.LogName)"
                if (-not $script:TamperLogFailureWarned.ContainsKey($warnKey)) {
                    $script:TamperLogFailureWarned[$warnKey] = $true
                    Write-MonitorAlert -Message "WARNING: Could not query '$($filter.LogName)' log for tamper events ($($_.Exception.Message))" -LogFile $LogFile -Color Yellow
                }
            }
        }
    }

    if (Test-TamperEventLogAvailable -LogName 'Microsoft-Windows-Sysmon/Operational') {
        try {
            Microsoft.PowerShell.Diagnostics\Get-WinEvent -FilterHashtable @{
                LogName   = 'Microsoft-Windows-Sysmon/Operational'
                Id        = 23
                StartTime = $Since
            } -ErrorAction Stop | Where-Object {
                $_.Message -match '(?i)\\Prefetch\\|\\bam\\|\\dam\\|UserSettings'
            } | ForEach-Object { $events += $_ }
        } catch {
            if ($_.Exception.Message -notmatch '(?i)no events were found') {
                $warnKey = 'winevent|Sysmon'
                if (-not $script:TamperLogFailureWarned.ContainsKey($warnKey)) {
                    $script:TamperLogFailureWarned[$warnKey] = $true
                    Write-MonitorAlert -Message "WARNING: Could not query Sysmon operational log for tamper events ($($_.Exception.Message))" -LogFile $LogFile -Color Yellow
                }
            }
        }
    }

    return $events
}

function Write-MonitorAlert {
    param(
        [string]$Message,
        [string]$LogFile,
        [string]$Color = 'Yellow'
    )

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    Write-Host "[$timestamp] $Message" -ForegroundColor $Color
    Invoke-ConsoleRefresh
    try {
        Add-Content -LiteralPath $LogFile -Value "[$timestamp] $Message" -ErrorAction Stop
    } catch {
        $fallback = Join-Path $env:TEMP 'ror_security_events.log'
        try { Add-Content -LiteralPath $fallback -Value "[$timestamp] $Message" -ErrorAction SilentlyContinue } catch {}
    }
}

